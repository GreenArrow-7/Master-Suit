<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No backup and no device-to-device transfer of app data: the WebView's cookie
      store holds the signed-in session, and restoring it onto another phone would
      carry the session with it. Cleartext is refused outright; the app only loads
      an https origin.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Only what the implemented journey uses. CAMERA backs "Take photo" on lead
      documents: the WebView cannot hand the page a camera the app does not hold,
      and Capacitor asks for it at the moment of capture.

      Not declared in this development build, on purpose: location (face check-in
      and the site-visit GPS punch are not part of the verified journey, so those
      screens cannot read a position in the app), microphone, and notifications
      (push is not configured). Add each with the feature that is verified to need it.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Declaring CAMERA otherwise makes Play treat a camera as a hardware
      requirement and hides the app from devices without one. Office staff on a
      cameraless tablet still need the CRM.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
