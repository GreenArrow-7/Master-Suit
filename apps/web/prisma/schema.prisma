  employeeId      String
  phase           String
  title           String
  ownerDepartment String?
  sequence        Int              @default(0)
  dueDate         DateTime?
  blocking        Boolean          @default(false)
  notes           String?
  completedAt     DateTime?
  completedById   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        EmployeeProfile  @relation("HrChecklistEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  completedBy     EmployeeProfile? @relation("HrChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId, phase, title])
  @@index([tenantId, phase, completedAt, dueDate])
}

model HrOffboardingCase {
  id                  String                 @id @default(cuid())
  tenantId            String
  employeeId          String
  noticeGivenOn       DateTime
  noticePeriodDays    Int
  lastWorkingOn       DateTime
  separationType      String
  reason              String
  noticeShortfallDays Int                    @default(0)
  settlementPaidAt    DateTime?
  startedById         String?
  startedAt           DateTime               @default(now())
  completedAt         DateTime?
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee            EmployeeProfile        @relation("HrOffboardingEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  startedBy           EmployeeProfile?       @relation("HrOffboardingStarter", fields: [startedById], references: [id], onDelete: SetNull)
  settlements         HrSettlementSnapshot[]

  @@index([tenantId, employeeId, completedAt])
