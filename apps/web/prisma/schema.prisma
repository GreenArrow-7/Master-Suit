}

// ─────────────────────────────────────────────────────────────────────────────
// EMPLOYEE TARGETS
// ─────────────────────────────────────────────────────────────────────────────

enum TargetPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum TargetMetric {
  LEADS_ASSIGNED
  CALLS_ATTEMPTED
  CALLS_CONNECTED
  FOLLOWUPS_COMPLETED
  INVITATIONS_SENT
  RSVPS_CONFIRMED
  LEADS_QUALIFIED
  LEADS_CONVERTED
}

model EmployeeTarget {
