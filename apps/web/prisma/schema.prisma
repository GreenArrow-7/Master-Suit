// LeadFlow CRM — canonical data model
// Conventions:
//   * Every business table carries: id, tenantId, createdAt, updatedAt, createdById, updatedById
//   * Soft-deletable tables carry deletedAt (partial unique indexes are applied in raw SQL, see
//     prisma/migrations/*/partial_indexes.sql — Prisma cannot express WHERE clauses on unique indexes)
//   * createdById / updatedById are scalar references (FK constraints added in raw SQL) to keep the
//     User model free of ~120 inverse relations. Traversable relations are declared only where the
//     application actually joins.
//   * Custom fields use a hybrid model: normalized definition + value tables for integrity and
//     reporting, plus a denormalized `customData Json` column on the parent for grid filtering
//     (GIN-indexed). The value tables are the source of truth; customData is a projection.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "relationJoins"]
}

// Prisma 7: connection URLs live in prisma.config.ts (Migrate) and the driver
// adapter is passed to the PrismaClient constructor (runtime). See src/lib/db.ts.
// Prisma 7 keeps the connection URL in prisma.config.ts, not here. The CLI
// (migrate, studio) connects as MIGRATION_DATABASE_URL — the owning role, which
// has the DDL rights policies need. The running application never reads this
// block: it connects through the PrismaPg adapter in src/lib/db.ts using
// DATABASE_URL, the NOBYPASSRLS application role.
datasource db {
  provider = "postgresql"
}

