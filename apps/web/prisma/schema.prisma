  latitude              Float?
  longitude             Float?
  company               String?
  jobTitle              String?
  industry              String?
  source                RecordSource  @default(MANUAL)
  sourceDetail          String?
  subSource             String?
  campaignId            String?
  productInterestId     String?
  stageId               String
  status                String?
  score                 Int           @default(0)
  grade                 String?
