// ─────────────────────────────────────────────────────────────────────────────
// EVENTS & RSVP
// ─────────────────────────────────────────────────────────────────────────────

enum EventType {
  ONLINE
  PHYSICAL
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
  TENTATIVE
  NO_RESPONSE
  ATTENDED
  NO_SHOW
}

enum InviteChannel {
  EMAIL
  WHATSAPP
  SMS
  IN_APP
}

model Event {
  id                 String      @id @default(cuid())
  tenantId           String
  campaignId         String?
  title              String
  description        String?
  eventType          EventType   @default(PHYSICAL)
  status             EventStatus @default(DRAFT)
  startAt            DateTime
  endAt              DateTime
  timezone           String      @default("Asia/Dubai")
  hostId             String?
  location           String?
  address            String?
  latitude           Float?
  longitude          Float?
  meetingUrl         String?
  capacity           Int?
  registeredCount    Int         @default(0)
  attendedCount      Int         @default(0)
  externalCalendarId String?
  externalMeetId     String?
  notes              String?
  reminderSentAt     DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  invitees EventInvitee[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, startAt])
  @@index([tenantId, campaignId])
  @@index([tenantId, hostId])
}

model EventInvitee {
  id              String         @id @default(cuid())
  tenantId        String
  eventId         String
  leadId          String?
  contactId       String?
  userId          String?
  email           String?
  phone           String?
  name            String?
  rsvpStatus      RsvpStatus     @default(PENDING)
  rsvpAt          DateTime?
  rsvpChannel     InviteChannel?
  /// When the invitee first opened their RSVP link. Its own column rather than
  /// an RsvpStatus value, because viewing and answering are orthogonal — someone
  /// who opens the link and declines is both, and one enum cannot hold both.
  viewedAt        DateTime?
  invitedAt       DateTime       @default(now())
  inviteChannel   InviteChannel  @default(EMAIL)
  inviteSentAt    DateTime?
  inviteDelivered Boolean        @default(false)
  reminderSentAt  DateTime?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  notes           String?
  createdAt       DateTime       @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([eventId, leadId])
  @@index([tenantId, eventId, rsvpStatus])
  @@index([tenantId, leadId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN SCRIPTS & TALKING POINTS
// ─────────────────────────────────────────────────────────────────────────────

model CampaignScript {
  id          String   @id @default(cuid())
  tenantId    String
  campaignId  String
  title       String
  content     String
  isDefault   Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  talkingPoints CampaignTalkingPoint[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId, position])
}

model CampaignTalkingPoint {
  id          String  @id @default(cuid())
  tenantId    String
  campaignId  String
  scriptId    String?
  label       String
  description String?
  isRequired  Boolean @default(false)
  position    Int     @default(0)

  script CampaignScript? @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId, position])
}

model CampaignQualification {
  id             String  @id @default(cuid())
  tenantId       String
  campaignId     String
  question       String
  expectedAnswer String?
  isRequired     Boolean @default(true)
  position       Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId, position])
}

model CampaignMember {
  id         String    @id @default(cuid())
  tenantId   String
  campaignId String
  userId     String
  role       String    @default("CALLER")
  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([tenantId, campaignId])
  @@index([tenantId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Real-estate inventory — projects (M4)
//
// Inventory is reference data, not owned records. Every RM must see the whole
// catalogue to pitch it, so there is no `ownerId` here and no visibility scoping
// on read — only the write actions are permission-gated. That is a deliberate
// departure from Lead and Opportunity, and the reason `projects` is its own
// permission module rather than a reuse of `products`.
//
// `tenantId` carries no Prisma relation to Tenant, matching Call, Recording,
// Transcript and the campaign models: the relation buys a cascade this schema
// gets from the RLS policy and the workspace archive path instead, and adding
// eight back-relations to Tenant is eight more lines to conflict over.
// ─────────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNED
  PRE_LAUNCH
  LAUNCHED
  UNDER_CONSTRUCTION
  READY
  SOLD_OUT
  ON_HOLD
}

/// What a buyer actually asks: can I move in, or am I waiting? Distinct from
/// ProjectStatus, which is where the developer is in their own process.
enum PossessionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
  NEW_LAUNCH
}

enum UnitStatus {
  AVAILABLE
  HELD
  BOOKED
  SOLD
  BLOCKED
}

enum ProjectMediaKind {
  IMAGE
  FLOOR_PLAN
  BROCHURE
  CREATIVE
  VIDEO
  VR_TOUR
}

model Developer {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  about           String?
  logoUrl         String?
  reraId          String?
  establishedYear Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?

  projects Project[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive, name])
}

/// The unit a buyer thinks in — "Dubai Marina", not "Dubai". Facets hang off it.
model Micromarket {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  city      String
  state     String?
  country   String   @default("AE")
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  listings Listing[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, city, name])
  @@index([tenantId, isActive, city, name])
}

/// A controlled vocabulary, so filters do not fragment across "Gym",
/// "Gymnasium" and "gym". Projects reference it by `key` in an array rather
/// than through a join table — see Project.amenityKeys.
model Amenity {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  label     String
  category  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, category, position])
}

model Project {
  id            String  @id @default(cuid())
  tenantId      String
  name          String
  code          String
  developerId   String?
  micromarketId String?

  status           ProjectStatus    @default(LAUNCHED)
  possessionStatus PossessionStatus @default(UNDER_CONSTRUCTION)
  possessionAt     DateTime?

  /// Money is Decimal and carries its currency, per the platform rule. The band
  /// is stored on the project rather than derived from UnitPlan on every read:
  /// the catalogue filters on price at 100k rows and cannot afford the join.
  /// Kept in step by recalculateProjectRollups() whenever a plan or unit moves.
  minPrice     Decimal? @db.Decimal(18, 2)
  maxPrice     Decimal? @db.Decimal(18, 2)
  pricePerSqft Decimal? @db.Decimal(18, 2)
  currency     String   @default("AED")

  minAreaSqft Int?
  maxAreaSqft Int?

  /// Faceted on directly. Arrays with GIN indexes rather than join tables,
  /// because every query here is "has any of these" over a small set and a join
  /// would cost a second index scan per facet.
  /// ponytail: no referential integrity to Amenity — the admin UI is the only
  /// writer and it picks from the list. Add a join table if an importer ever
  /// writes these directly.
  unitTypes   String[] @default([])
  amenityKeys String[] @default([])
  highlights  String[] @default([])

  address     String?
  latitude    Float?
  longitude   Float?
  description String?

  /// RERA, and the equivalent regulator elsewhere. Nullable because a pre-launch
  /// project has no number yet, and a workspace outside a RERA jurisdiction
  /// never will.
  reraNumber     String?
  reraAuthority  String?
  reraApprovedAt DateTime?
  reraExpiresAt  DateTime?

  /// Denormalised counters. "Live availability" on a catalogue row cannot be a
  /// correlated count at 100k rows, so UnitInventory transitions recompute these
  /// inside the same transaction that moves the unit.
  totalUnits     Int @default(0)
  availableUnits Int @default(0)
  soldUnits      Int @default(0)

  /// Editorially chosen: what the floor pitches today, and what it may pitch at
  /// all. Separate flags because "stop featuring this" is not "stop selling it".
  isPriority  Boolean @default(false)
  isPitchable Boolean @default(true)

  launchedAt  DateTime?
  completedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  developer   Developer?         @relation(fields: [developerId], references: [id], onDelete: SetNull)
  micromarket Micromarket?       @relation(fields: [micromarketId], references: [id], onDelete: SetNull)
  media       ProjectMedia[]
  unitPlans   UnitPlan[]
  units       UnitInventory[]
  favourites  ProjectFavourite[]
  listings    Listing[]
  siteVisits  SiteVisit[]
  bookings    Booking[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  /// The keyset order. Every list page ends in (updatedAt DESC, id DESC), so the
  /// planner gets one index for the sort whichever facet was applied.
  @@index([tenantId, deletedAt, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, micromarketId, status])
  @@index([tenantId, developerId, status])
  @@index([tenantId, possessionStatus, possessionAt])
  @@index([tenantId, status, minPrice])
  @@index([tenantId, isPitchable, isPriority])
  /// Declared here, not only in the migration.
  ///
  /// `prisma migrate diff` proposed dropping all three the moment the next
  /// module was added, because an index the datamodel cannot see is an index
  /// Prisma believes should not exist — and dropping them turns a 110 ms
  /// catalogue into a sequential scan with nothing failing to say so.
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Project_name_trgm_idx", type: Gin)
  @@index([amenityKeys], map: "Project_amenityKeys_idx", type: Gin)
  @@index([unitTypes], map: "Project_unitTypes_idx", type: Gin)
  /// The list view: every cursor page orders by (updatedAt DESC, id DESC).
  @@index([tenantId, updatedAt(sort: Desc), id(sort: Desc)])
}

model ProjectMedia {
  id          String           @id @default(cuid())
  tenantId    String
  projectId   String
  kind        ProjectMediaKind @default(IMAGE)
  title       String?
  /// Object key for anything we host. Mutually exclusive with `externalUrl`,
  /// which is for embeds we deliberately do not copy — a Matterport tour or a
  /// developer walkthrough is theirs to host and theirs to take down.
  storageKey  String?
  externalUrl String?
  mimeType    String?
  sizeBytes   Int?
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  createdById String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, kind, position])
}

/// A typology — "2 BHK Type A" — not a sellable unit. Catalogue pricing comes
/// from here; availability comes from UnitInventory.
model UnitPlan {
  id              String   @id @default(cuid())
  tenantId        String
  projectId       String
  name            String
  unitType        String
  bedrooms        Int?
  bathrooms       Int?
  carpetAreaSqft  Int?
  builtUpAreaSqft Int?
  price           Decimal? @db.Decimal(18, 2)
  currency        String   @default("AED")
  floorPlanKey    String?
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   UnitInventory[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, position])
  @@index([tenantId, unitType])
}

/// One sellable unit. The row a booking eventually points at.
model UnitInventory {
  id         String     @id @default(cuid())
  tenantId   String
  projectId  String
  unitPlanId String?
  tower      String?
  floor      Int?
  unitNumber String
  status     UnitStatus @default(AVAILABLE)
  price      Decimal?   @db.Decimal(18, 2)
  currency   String     @default("AED")
  areaSqft   Int?
  facing     String?

  /// A hold is a promise with an expiry. Without the expiry, held inventory is
  /// indistinguishable from sold inventory a week later.
  heldById  String?
  heldUntil DateTime?
  /// Set when the unit reaches BOOKED. The Booking record itself is M9.
  leadId    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitPlan   UnitPlan?   @relation(fields: [unitPlanId], references: [id], onDelete: SetNull)
  listings   Listing[]
  siteVisits SiteVisit[]
  bookings   Booking[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([projectId, unitNumber])
  @@index([tenantId, projectId, status])
  @@index([tenantId, status, heldUntil])
}

model ProjectFavourite {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([tenantId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Real-estate inventory — resale and rental listings (M5)
//
// Where M4 is developer inventory the whole floor pitches, this is stock the
// agency holds a mandate on: someone else's property, marketed under an
// agreement with an expiry date. That agreement is the difference, and it is why
// Mandate is a table rather than three columns on Listing — a listing outlives
// the mandates on it, and marketing a property whose mandate has lapsed is a
// compliance problem rather than an untidy record.
//
// `ownerId` is the agent, matching every other record in the platform so
// `visibilityWhere` works with its defaults. The person who owns the bricks is
// `propertyOwnerId`, pointing at Owner.
// ─────────────────────────────────────────────────────────────────────────────

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  DRAFT
  ACTIVE
  UNDER_OFFER
  SOLD
  RENTED
  WITHDRAWN
  /// The mandate lapsed. Distinct from WITHDRAWN, which is a decision.
  EXPIRED
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  PLOT
  OFFICE
  RETAIL
  WAREHOUSE
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum RentFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MandateType {
  EXCLUSIVE
  NON_EXCLUSIVE
  OPEN
}

enum MandateStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum RequirementPurpose {
  BUY
  RENT
}

enum RequirementStatus {
  OPEN
  MATCHED
  FULFILLED
  CLOSED
}

/// The landlord or vendor. Their contact details are the agency's book, so the
/// read routes mask them unless the caller holds listings:VIEW_SENSITIVE_FIELDS.
model Owner {
  id              String    @id @default(cuid())
  tenantId        String
  fullName        String
  phone           String?
  /// E.164, for duplicate detection — the same normaliser the leads use.
  phoneNormalized String?
  email           String?
  whatsappNumber  String?
  nationality     String?
  notes           String?
  /// The agent who holds the relationship.
  ownerId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?

  listings Listing[]
  mandates Mandate[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phoneNormalized])
  @@index([tenantId, ownerId])
  @@index([tenantId, fullName])
}

model Listing {
  id        String @id @default(cuid())
  tenantId  String
  reference String
  title     String

  listingType  ListingType
  status       ListingStatus @default(DRAFT)
  propertyType PropertyType  @default(APARTMENT)

  propertyOwnerId String?
  /// The agent. Named `ownerId` because visibilityWhere defaults to it, and a
  /// listing that is nobody's is a listing nobody chases.
  ownerId         String?

  /// A resale flat inside a project we already catalogue. Both optional: a villa
  /// on its own plot belongs to no project, and a listing can name the project
  /// without anyone having entered that specific unit.
  projectId       String?
  unitInventoryId String?
  micromarketId   String?

  address   String?
  latitude  Float?
  longitude Float?

  bedrooms      Int?
  bathrooms     Int?
  areaSqft      Int?
  parkingSpaces Int?
  furnishing    Furnishing?

  /// The asking price for a SALE, the rent for a RENT. One column because a
  /// listing is only ever one of the two, and two nullable columns would need a
  /// constraint to say the same thing in more places.
  price         Decimal        @db.Decimal(18, 2)
  currency      String         @default("AED")
  /// Meaningless on a sale; required on a rental. Enforced in the migration.
  rentFrequency RentFrequency?

  availableFrom DateTime?
  amenityKeys   String[]  @default([])
  highlights    String[]  @default([])
  description   String?

  /// Denormalised from the live mandate so the list can filter and sort on
  /// exclusivity without a join, and so an expired mandate is visible on the row
  /// rather than one click away. Written only by the mandate service.
  mandateType    MandateType?
  mandateExpires DateTime?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  propertyOwner Owner?         @relation(fields: [propertyOwnerId], references: [id], onDelete: SetNull)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unit          UnitInventory? @relation(fields: [unitInventoryId], references: [id], onDelete: SetNull)
  micromarket   Micromarket?   @relation(fields: [micromarketId], references: [id], onDelete: SetNull)
  media         ListingMedia[]
  mandates      Mandate[]
  siteVisits    SiteVisit[]
  bookings      Booking[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  /// The keyset order, matching the project catalogue.
  @@index([tenantId, deletedAt, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, listingType, price])
  @@index([tenantId, micromarketId, status])
  @@index([tenantId, propertyType, bedrooms])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, propertyOwnerId])
  /// Finding what lapsed, without scanning the book.
  @@index([tenantId, status, mandateExpires])
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Listing_title_trgm_idx", type: Gin)
  @@index([amenityKeys], map: "Listing_amenityKeys_idx", type: Gin)
  /// The list view: every cursor page orders by (updatedAt DESC, id DESC).
  @@index([tenantId, updatedAt(sort: Desc), id(sort: Desc)])
}

model ListingMedia {
  id          String           @id @default(cuid())
  tenantId    String
  listingId   String
  kind        ProjectMediaKind @default(IMAGE)
  title       String?
  storageKey  String?
  externalUrl String?
  mimeType    String?
  sizeBytes   Int?
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  createdById String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, listingId, kind, position])
}

/// The right to market a property, and the date that right ends.
///
/// Its own table rather than columns on Listing because a property is
/// re-mandated: an exclusive lapses, the owner shops around, and three months
/// later the same agency takes it back on an open mandate. Flattening that onto
/// the listing loses the history that says who was allowed to market it, when.
model Mandate {
  id        String        @id @default(cuid())
  tenantId  String
  listingId String
  ownerId   String
  type      MandateType   @default(NON_EXCLUSIVE)
  status    MandateStatus @default(DRAFT)

  startsAt  DateTime
  /// Required. A mandate without an end date is not a mandate, it is an
  /// assumption — and it is the assumption this table exists to stop.
  expiresAt DateTime

  /// The agency's cut. Percent of the sale price, or of the annual rent.
  commissionPct Decimal? @db.Decimal(6, 3)
  currency      String   @default("AED")

  /// The signed agreement in our own bucket.
  documentKey String?
  signedAt    DateTime?

  terminatedAt    DateTime?
  terminationNote String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner   Owner   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, listingId, status])
  /// The expiry sweep reads this.
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, ownerId])
}

/// What a client is looking for.
///
/// This is the one table from M3 the demand check needs — budget, locations,
/// property type, timeline. The rest of client profiling (profession, income
/// band, education, testimonials, referrals) is not built; matching stock to
/// demand does not need to know where somebody went to university.
model ClientRequirement {
  id       String @id @default(cuid())
  tenantId String

  /// A buyer is a Lead before they are a Contact and the requirement follows the
  /// person, so either may be set. The migration enforces at least one.
  leadId    String?
  contactId String?

  purpose RequirementPurpose
  status  RequirementStatus  @default(OPEN)

  propertyTypes  PropertyType[] @default([])
  micromarketIds String[]       @default([])

  bedroomsMin Int?
  bedroomsMax Int?
  areaMinSqft Int?

  budgetMin Decimal? @db.Decimal(18, 2)
  budgetMax Decimal? @db.Decimal(18, 2)
  currency  String   @default("AED")

  /// "I need to be in by March." Matched against a listing's availableFrom.
  possessionBy DateTime?
  furnishing   Furnishing?

  notes   String?
  /// The agent working it.
  ownerId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, purpose])
  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@index([tenantId, ownerId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// The auto-dialer (M7)
//
// Click-to-call, four telephony vendors, recordings, transcripts and campaigns
// already existed. What did not was the thing that turns a list into a shift:
// a queue an agent works through without deciding who to ring next.
//
// The acceptance criterion is the whole design — "dialer state survives a page
// refresh; no call is lost or double-dialled" — and it has three consequences
// visible below. The agent's position is a column, not client state. A contact
// is claimed by exactly one session at a time. And an agent has at most one
// live session, enforced by a partial unique index rather than by hoping.
// ─────────────────────────────────────────────────────────────────────────────

enum DialerSessionStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum CampaignContactStatus {
  PENDING
  /// Claimed by a session. Nobody else may take it.
  IN_PROGRESS
  COMPLETED
  /// The client asked to be rung back; `nextAttemptAt` says when.
  CALLBACK
  SKIPPED
  /// Out of attempts, or the number does not work.
  EXHAUSTED
  /// Do not contact. Terminal, and never re-queued.
  SUPPRESSED
}

/// One person to ring, once, as part of one campaign.
model CampaignContact {
  id         String @id @default(cuid())
  tenantId   String
  campaignId String

  /// Who. A campaign is built from leads today; contactId is here because the
  /// same queue will be pointed at an existing customer base for re-engagement.
  leadId    String?
  contactId String?

  /// Denormalised from the lead, because the queue is worked at speed and the
  /// number is what gets dialled. `phoneNormalized` is what the cooldown and
  /// the duplicate check compare — the raw string is what a human reads.
  displayName     String?
  phone           String
  phoneNormalized String?

  status   CampaignContactStatus @default(PENDING)
  /// Sequential order. The dialer hands them out by this, so a campaign can be
  /// ordered by score, by recency, or by whatever the loader chose.
  position Int                   @default(0)

  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  /// When this row becomes eligible again — a callback time, or a retry after
  /// no answer. NULL means "now".
  nextAttemptAt DateTime?

  /// Set while a session holds it. Released on advance, on end, and by the
  /// stale-claim sweep.
  claimedBySessionId String?
  claimedAt          DateTime?

  outcome    CallOutcome?
  /// The last call placed for this row, so the outcome can be traced to audio.
  lastCallId String?
  notes      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  /// One row per person per campaign. Ringing the same number twice off one
  /// list is the complaint that ends a campaign.

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phoneNormalized])
  @@index([tenantId, campaignId, status, position])
  @@index([tenantId, campaignId, nextAttemptAt])
  @@index([tenantId, claimedBySessionId])
  @@index([tenantId, leadId])
}

/// An agent working a campaign queue.
///
/// The row *is* the dialer. A refresh re-reads it and the agent is where they
/// were, on the same contact, with the same counts — there is no client state
/// to lose because there is no client state.
model DialerSession {
  id         String @id @default(cuid())
  tenantId   String
  campaignId String
  userId     String

  status DialerSessionStatus @default(ACTIVE)

  /// The contact currently in front of the agent. The single most important
  /// column here: it is what survives the refresh.
  currentContactId String?
  /// The call placed for that contact, if the agent has dialled yet.
  currentCallId    String?

  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  /// Touched on every advance. A session idle past the ceiling is reaped and
  /// its claim released, so one closed laptop cannot strand a contact.
  lastActivityAt DateTime  @default(now())

  dialed    Int @default(0)
  connected Int @default(0)
  skipped   Int @default(0)
  callbacks Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId, status])
  @@index([tenantId, userId, status])
  @@index([tenantId, status, lastActivityAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Site visits and client meetings (M6)
//
// One table, not two, and that is the decision worth defending. The spec names
// `SiteVisit` and `Meeting` separately, but they share a lifecycle (requested →
// approved → checked in → completed), a geo check-in, and one leader
// verification queue. Two tables would be two copies of the same state machine
// and two queues a manager has to remember to look at; `kind` distinguishes
// them in the one place they actually differ, which is where the appointment is.
//
// It is deliberately *not* `FieldVisit`, which already exists. That records a
// rep calling on a lead: no approval, no client in the car, no property. A site
// visit is a client taken to see something, which needs signing off before it
// happens and verifying after.
// ─────────────────────────────────────────────────────────────────────────────

enum SiteVisitKind {
  /// Taking a client to see a project or a listing.
  PROPERTY_VISIT
  /// Meeting a client somewhere — their office, a café, or online.
  CLIENT_MEETING
}

enum SiteVisitStatus {
  REQUESTED
  APPROVED
  REJECTED
  /// The agent has punched in at the destination.
  CHECKED_IN
  COMPLETED
  CANCELLED
  /// Approved, the time passed, nobody arrived.
  NO_SHOW
}

enum VisitVerification {
  /// Nobody has looked at it yet.
  PENDING
  VERIFIED
  /// A leader looked and did not believe it.
  DISPUTED
}

model SiteVisit {
  id       String        @id @default(cuid())
  tenantId String
  kind     SiteVisitKind @default(PROPERTY_VISIT)

  /// The agent taking the client. Named `ownerId` so visibilityWhere works with
  /// its defaults, like every other owned record on the platform.
  ownerId String

  /// Who is being taken. A lead becomes a contact; either may be set.
  leadId    String?
  contactId String?

  /// Where. A project, a specific unit, a listing, or a free address for a
  /// meeting. All optional because a CLIENT_MEETING may be at a café, and the
  /// migration enforces that a property visit names something.
  projectId       String?
  unitInventoryId String?
  listingId       String?

  address    String?
  latitude   Float?
  longitude  Float?
  /// Set for an online meeting. Populated by the Google Meet integration when
  /// the workspace has connected it.
  meetingUrl String?

  status       SiteVisitStatus   @default(REQUESTED)
  verification VisitVerification @default(PENDING)

  scheduledAt DateTime
  durationMin Int      @default(60)

  /// Approval. A site visit costs a car, a set of keys and often a developer's
  /// time, which is why it is requested rather than simply booked.
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  /// The punch. Coordinates are recorded as measured — never a client-reported
  /// "I am here" flag, which is a boolean anybody can send.
  checkInAt       DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkInAccuracy Float?
  checkOutAt      DateTime?
  checkOutLat     Float?
  checkOutLng     Float?

  /// Metres between the punch and the destination, and whether that is inside
  /// the workspace's radius. Null when there was nothing to measure against.
  distanceMeters Int?
  geofenceOk     Boolean?

  /// Server-side plausibility, per docs/ARCHITECTURE §5: the browser cannot
  /// detect a mocked GPS, so the checks are travel speed between consecutive
  /// punches and coordinates repeated to the metre. Flagged for a human, never
  /// hard-blocked — a genuine visit from a passenger seat looks like a fast one.
  locationSuspect Boolean @default(false)
  suspectReason   String?

  outcome String?
  notes   String?

  /// Every edit after COMPLETED carries a reason, and the reason is what the
  /// audit row quotes. See the acceptance criterion in the migration.
  amendedAt   DateTime?
  amendedById String?
  amendReason String?

  verifiedById String?
  verifiedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unit    UnitInventory? @relation(fields: [unitInventoryId], references: [id], onDelete: SetNull)
  listing Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerId, scheduledAt])
  @@index([tenantId, status, scheduledAt])
  /// The approval queue and the verification queue, which are the two lists a
  /// leader actually opens.
  @@index([tenantId, status, verification])
  @@index([tenantId, projectId, scheduledAt])
  @@index([tenantId, leadId])
  /// The plausibility check reads a user's punches in time order.
  @@index([tenantId, ownerId, checkInAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Bookings, commissions and payouts (M9)
//
// The spec gates this module: the commission slab rules must be documented and
// signed off by finance before any code is written. That constraint is honoured
// by putting **no rates in the code at all**. A slab is rows — bands, a mode, an
// effective window and an approver — and `accrueCommission` refuses to run until
// a workspace has entered one that is signed off. Nothing here knows what 2.5%
// means; it knows how to apply whatever finance entered and how to prove which
// version it applied.
//
// The other decision worth stating: every commission carries a frozen copy of
// the rule that produced it. `ratePct`, `mode` and `slabVersion` are resolved at
// accrual and never re-read. A workspace that renegotiates its rates in March
// must not restate February's ledger, and a payout already made must stay
// reconcilable against the number that produced it.
// ─────────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  DRAFT
  CONFIRMED
  /// The sale fell through. Commissions already accrued are clawed back, not
  /// deleted — see CommissionStatus.CLAWED_BACK.
  CANCELLED
}

enum SlabMode {
  /// Each band applies to the portion of the sale that falls inside it, the way
  /// income tax works.
  PROGRESSIVE
  /// The whole sale takes the rate of the band it lands in.
  FLAT
}

enum SlabBasis {
  /// A percentage of what the client paid.
  PERCENT_OF_SALE
  /// A percentage of the agency's own fee, when the developer pays the agency
  /// and the agency shares with the agent.
  PERCENT_OF_AGENCY_FEE
  /// A flat amount per booking, regardless of size.
  FIXED
}

enum CommissionStatus {
  /// Earned on paper. The booking exists; nobody has been paid anything.
  ACCRUED
  /// A human with the authority has agreed the number is right.
  CONFIRMED
  /// The client's money is in. This is the gate before anyone is paid.
  COLLECTED
  PAID
  /// Reversed after the fact. Terminal, and always paired with the row it reverses.
  CLAWED_BACK
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

/// A sale. The row every commission traces back to.
model Booking {
  id        String @id @default(cuid())
  tenantId  String
  reference String

  /// Who bought.
  leadId    String?
  contactId String?
  accountId String?

  /// What was bought. A unit in a project, or a listing.
  projectId       String?
  unitInventoryId String?
  listingId       String?

  /// The agent credited. Splits between several agents live on Commission.
  ownerId String

  /// Where the agent sat when the sale was confirmed, copied from their record
  /// at that moment.
  ///
  /// A P&L read through the agent's *current* team silently moves last
  /// quarter's revenue when somebody transfers, which restates a period that
  /// was closed. The same reasoning as the frozen commission slab: the rollup
  /// must keep answering what it answered at the time.
  teamId   String?
  branchId String?
  regionId String?

  status BookingStatus @default(DRAFT)

  /// What the client pays. Money is Decimal and carries its currency.
  saleValue Decimal  @db.Decimal(18, 2)
  /// What the developer or landlord pays the agency, when that differs from a
  /// simple percentage of the sale. Null means the slab computes from saleValue.
  agencyFee Decimal? @db.Decimal(18, 2)
  currency  String   @default("AED")

  bookingDate   DateTime
  agreementDate DateTime?
  /// When the client's money actually arrived. Commissions cannot reach
  /// COLLECTED before this is set.
  collectedAt   DateTime?

  cancelledAt  DateTime?
  cancelReason String?

  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  /// Soft only. The platform rule is that nothing with a commission attached is
  /// ever hard-deleted, and by the time a booking exists one usually is.
  deletedAt   DateTime?

  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unit        UnitInventory? @relation(fields: [unitInventoryId], references: [id], onDelete: SetNull)
  listing     Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  commissions Commission[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([tenantId, teamId, bookingDate])
  @@index([tenantId, regionId, bookingDate])
  @@index([tenantId, status, bookingDate])
  @@index([tenantId, ownerId, bookingDate])
  @@index([tenantId, projectId])
  @@index([tenantId, leadId])
}

/// A commission rule, as finance wrote it.
///
/// Effective-dated rather than edited in place: a rate that changes in March
/// must not restate February, so a new rate is a new version and the old one is
/// closed. `approvedById` is the sign-off the spec requires — a slab without one
/// cannot be used to accrue anything.
model CommissionSlab {
  id       String @id @default(cuid())
  tenantId String
  name     String
  version  Int    @default(1)

  mode  SlabMode  @default(PROGRESSIVE)
  basis SlabBasis @default(PERCENT_OF_SALE)

  /// What this slab covers. All null means it is the workspace default; the
  /// most specific match wins at accrual time.
  projectId   String?
  developerId String?
  listingType String?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  /// Finance's signature. Nothing accrues against an unapproved slab.
  approvedById String?
  approvedAt   DateTime?
  approvalNote String?

  currency    String   @default("AED")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  bands       CommissionSlabBand[]
  commissions Commission[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, version])
  @@index([tenantId, isActive, effectiveFrom])
  @@index([tenantId, projectId])
}

/// One band of a slab. "From 0 to 1,000,000 at 2%."
model CommissionSlabBand {
  id       String @id @default(cuid())
  tenantId String
  slabId   String

  /// Inclusive lower bound, exclusive upper. `toAmount` null means "and above".
  fromAmount Decimal  @db.Decimal(18, 2)
  toAmount   Decimal? @db.Decimal(18, 2)

  /// One of the two applies, decided by the slab's basis.
  ratePct     Decimal? @db.Decimal(9, 4)
  fixedAmount Decimal? @db.Decimal(18, 2)

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slab CommissionSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, slabId, position])
}

/// What one person earned on one booking.
model Commission {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String
  /// Who earns it. Several rows per booking when the deal is split.
  userId    String

  status CommissionStatus @default(ACCRUED)

  /// The rule that produced this number, frozen. Read once at accrual and never
  /// again — a later rate change must not restate a ledger that has been paid.
  slabId           String?
  slabVersion      Int?
  slabMode         SlabMode?
  slabBasis        SlabBasis?
  /// The effective rate across the whole base, after the bands were applied.
  /// Stored so a statement can show one number a human can check.
  effectiveRatePct Decimal?   @db.Decimal(9, 4)
  /// Which bands were used and what each contributed. The audit trail for the
  /// arithmetic, so a disputed payout can be reconstructed without re-running it.
  calculation      Json       @default("{}")

  /// What the rate applied to.
  baseAmount Decimal @db.Decimal(18, 2)
  /// This person's share of the deal, out of 100.
  sharePct   Decimal @default(100) @db.Decimal(7, 4)
  /// The money. baseAmount → bands → share → this.
  amount     Decimal @db.Decimal(18, 2)
  currency   String  @default("AED")

  confirmedById String?
  confirmedAt   DateTime?
  collectedAt   DateTime?
  payoutId      String?
  paidAt        DateTime?

  /// A clawback points at the commission it reverses, and carries a negative
  /// amount. The original is left exactly as it was.
  reversesId   String?
  clawbackNote String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  booking Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  slab    CommissionSlab? @relation(fields: [slabId], references: [id], onDelete: SetNull)
  payout  Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@index([tenantId, bookingId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, payoutId])
}

/// A batch of commissions paid to one person for one period.
model Payout {
  id        String @id @default(cuid())
  tenantId  String
  reference String
  userId    String

  status PayoutStatus @default(DRAFT)

  periodStart DateTime
  periodEnd   DateTime

  /// The sum of the commissions attached, recomputed whenever the set changes.
  /// Denormalised because a statement is read far more often than it is built.
  totalAmount Decimal @default(0) @db.Decimal(18, 2)
  currency    String  @default("AED")

  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  paymentRef   String?
  note         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  commissions Commission[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([tenantId, userId, status])
  @@index([tenantId, status, periodEnd])
}

// ─────────────────────────────────────────────────────────────────────────────
// Client profiling (M3)
//
// The requirement — budget, locations, type, timeline — already existed, because
// the demand check needed it. This is the rest: who the buyer is, what they say
// about you afterwards, and who they send next.
//
// Two decisions worth stating. Income and investment capacity are Decimal pairs
// with a currency rather than an enum of bands, because a fixed band ladder is
// wrong in the second market you sell in and an enum cannot be changed without a
// migration; a pair of numbers expresses any band a workspace wants to offer.
// And employer, job title and industry are not repeated here — they are already
// on Lead, and a profile that disagrees with the lead record is worse than one
// that does not answer.
// ─────────────────────────────────────────────────────────────────────────────

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  BUSINESS_OWNER
  PROFESSIONAL
  RETIRED
  STUDENT
  NOT_WORKING
  UNDISCLOSED
}

enum EducationLevel {
  SCHOOL
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
  UNDISCLOSED
}

/// Why they are buying. Drives what you show them far more than budget does:
/// an investor wants yield and exit, an end user wants the school run.
enum PurchaseIntent {
  END_USE
  INVESTMENT
  BOTH
  UNDECIDED
}

/// Who the buyer is.
///
/// Every field is optional on purpose: the profile is filled in over several
/// conversations, not one form, and a wizard that refuses to save until it knows
/// somebody's education simply does not get filled in. Completeness is derived
/// from what is answered rather than stored, so it cannot drift from the row.
model ClientProfile {
  id       String @id @default(cuid())
  tenantId String

  /// A buyer is a Lead before they are a Contact and the profile follows the
  /// person, exactly as ClientRequirement does. The migration enforces one.
  leadId    String?
  contactId String?

  profession     String?
  employmentType EmploymentType?
  education      EducationLevel?
  /// ISO codes, matching User.languages. What you can actually sell them in.
  languages      String[]        @default([])

  purchaseIntent PurchaseIntent @default(UNDECIDED)

  /// A band, expressed as its edges. Either may stand alone: "over 500k" is a
  /// minimum with no maximum, and that is a real answer.
  annualIncomeMin    Decimal? @db.Decimal(18, 2)
  annualIncomeMax    Decimal? @db.Decimal(18, 2)
  /// What they can actually put in, which is not their income.
  investmentCapacity Decimal? @db.Decimal(18, 2)
  currency           String   @default("AED")

  /// Where the money comes from — mortgage pre-approval changes the timeline.
  isMortgageRequired  Boolean?
  mortgagePreApproved Boolean?

  nationality     String?
  residencyStatus String?

  notes   String?
  ownerId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@index([tenantId, purchaseIntent])
  @@index([tenantId, ownerId])
}

enum TestimonialStatus {
  /// Asked for, not yet written.
  REQUESTED
  /// The client wrote it. Nobody has read it yet.
  SUBMITTED
  APPROVED
  PUBLISHED
  /// They said no, or it was not usable. Kept, because asking again next quarter
  /// after somebody declined is how you lose a client.
  DECLINED
}

/// What a client says about you.
///
/// Requested, written by them over a signed link, then read by somebody before
/// it goes anywhere. Approval and publication are separate states because they
/// are separate decisions: "this is not embarrassing" is not "put it on the
/// website under their full name".
model Testimonial {
  id       String @id @default(cuid())
  tenantId String

  leadId    String?
  contactId String?

  status TestimonialStatus @default(REQUESTED)

  requestedById  String
  requestedAt    DateTime @default(now())
  /// What the agent asked for, shown to the client on the public page.
  requestMessage String?

  /// 1–5. Constrained in the database; a 7-star review is a bug, not an opinion.
  rating      Int?
  body        String?
  submittedAt DateTime?

  /// Their words on a public page carries their name with it. Recorded from the
  /// public form, never set by staff.
  consentToPublish Boolean @default(false)
  /// What they want to be called in public, if not their full name.
  displayName      String?

  approvedById  String?
  approvedAt    DateTime?
  publishedAt   DateTime?
  declinedAt    DateTime?
  declineReason String?

  ownerId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, requestedAt(sort: Desc)])
  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@index([tenantId, ownerId, status])
}

enum ReferralStatus {
  /// The code was used; this is a new lead nobody has worked yet.
  PENDING
  QUALIFIED
  CONVERTED
  REJECTED
}

/// A client's referral code.
///
/// Issuing one is the referral request: there is no separate "asked" record,
/// because a code that exists is an ask that happened. Short and typeable
/// because it gets read aloud and forwarded on WhatsApp, which rules out the
/// signed token used for testimonial links.
model ReferralCode {
  id       String @id @default(cuid())
  tenantId String

  code String

  leadId    String?
  contactId String?

  issuedById String
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  /// A code somebody can hand to the whole street costs you every commission on
  /// the street. Null means no ceiling.
  maxUses Int?

  ownerId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  referrals Referral[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@index([tenantId, isActive, expiresAt])
}

/// One person, sent by another.
///
/// Separate from a column on Lead because a referral outlives the lead's own
/// status: it has to stay attributable after the lead converts, is merged, or is
/// rejected, and somebody eventually gets paid on it.
model Referral {
  id       String @id @default(cuid())
  tenantId String

  codeId         String
  /// The lead the referral produced. One referral per lead — the partial unique
  /// index says so, because two agents both claiming to have introduced the same
  /// buyer is a commission dispute.
  referredLeadId String

  status ReferralStatus @default(PENDING)

  /// Frozen at redemption. The code may later be deactivated or reassigned, and
  /// that must not restate who introduced whom.
  referrerLeadId    String?
  referrerContactId String?

  qualifiedAt  DateTime?
  convertedAt  DateTime?
  rejectedAt   DateTime?
  rejectReason String?

  notes String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  code ReferralCode @relation(fields: [codeId], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, codeId])
  @@index([tenantId, referrerLeadId])
  @@index([tenantId, referrerContactId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Engagement (M11)
//
// The last module, and the one with the least new machinery under it. RSVP to an
// offsite already works: `EventInvitee` carries a `userId`, so an event can
// invite staff and they answer through the same signed link a client does.
// Contest standings are the ranking M10 already computes. What is genuinely new
// is a place to post, a contest to freeze the result of, and a way to nominate
// and vote.
// ─────────────────────────────────────────────────────────────────────────────

enum PostKind {
  UPDATE
  ANNOUNCEMENT
  CELEBRATION
  QUESTION
}

/// Something somebody said to the whole workspace.
///
/// Media is either an object in our bucket or a link, never both. The listings
/// rule that videos are always linked does not apply here: an internal clip is
/// filmed on somebody's phone and belongs behind our own access control, not on
/// a vendor's platform.
model Post {
  id       String @id @default(cuid())
  tenantId String

  authorId String
  kind     PostKind @default(UPDATE)
  body     String

  /// Uploaded to our bucket. Exclusive with videoUrl.
  videoKey  String?
  /// Linked from wherever it already lives. Exclusive with videoKey.
  videoUrl  String?
  /// Still frame, so a feed does not have to load every clip to render.
  posterKey String?

  /// Kept at the top of the feed. Leadership announcements outlive the hour
  /// they were posted in.
  isPinned Boolean @default(false)

  /// Taken down rather than erased: moderation that leaves no trace is
  /// indistinguishable from a bug, and the author is owed a reason.
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  reactions PostReaction[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isPinned, createdAt(sort: Desc)])
  @@index([tenantId, authorId, createdAt(sort: Desc)])
}

enum ReactionKind {
  LIKE
  CELEBRATE
  SUPPORT
  INSIGHTFUL
}

/// One person's reaction to one post. Changing your mind updates the row rather
/// than adding a second, which the unique index enforces.
model PostReaction {
  id       String @id @default(cuid())
  tenantId String

  postId String
  userId String
  kind   ReactionKind @default(LIKE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([tenantId, postId])
}

enum ContestStatus {
  DRAFT
  /// Running. Standings are live and change as the underlying work does.
  OPEN
  /// Finished. Standings are frozen and no longer recomputed.
  CLOSED
  CANCELLED
}

/// A time-boxed leaderboard over one metric.
///
/// The metric names a rollup that already exists rather than a formula stored
/// here, because a contest that computes its own numbers is a second answer to
/// "who sold the most" and the two will disagree.
model Contest {
  id       String @id @default(cuid())
  tenantId String

  name        String
  description String?
  /// One of the leaderboard metrics in services/leadership/rollups.
  metric      String
  status      ContestStatus @default(DRAFT)

  startAt DateTime
  endAt   DateTime

  /// Null means the whole workspace competes.
  teamId String?

  prize String?

  closedAt   DateTime?
  closedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  standings ContestStanding[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, endAt])
  @@index([tenantId, teamId])
}

/// The result, written once when the contest closes.
///
/// Frozen deliberately. A booking cancelled in March must not silently change
/// who won February — the same reasoning as the commission snapshot and the
/// booking's frozen team.
model ContestStanding {
  id       String @id @default(cuid())
  tenantId String

  contestId String
  userId    String
  rank      Int
  /// The metric's value at close, as a string so an integer count and a money
  /// total can share one column without either being rounded into the other.
  value     String

  createdAt DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([tenantId, contestId, rank])
}

enum NominationStatus {
  /// Put forward, open for votes.
  OPEN
  WITHDRAWN
  /// The category closed and this one had the most votes.
  WON
}

/// Somebody put forward for something, usually at an offsite.
///
/// Hangs off an Event because that is where the award is given and where the
/// RSVP already lives. `category` is free text rather than an enum: every
/// company's awards are different and an enum would need a migration each time
/// somebody invents "Best Newcomer".
model Nomination {
  id       String @id @default(cuid())
  tenantId String

  eventId  String
  category String

  nomineeId     String
  nominatedById String
  reason        String?

  status NominationStatus @default(OPEN)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deletedAt   DateTime?

  votes NominationVote[]

  /// The same person cannot be put forward twice in one category at one event.

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([eventId, category, nomineeId])
  @@index([tenantId, eventId, category])
  @@index([tenantId, nomineeId])
}

/// One vote. The unique index is per category, not per nomination, so somebody
/// cannot vote for every nominee in the same category.
model NominationVote {
  id       String @id @default(cuid())
  tenantId String

  nominationId String
  /// Copied from the nomination so the one-vote-per-category rule can be an
  /// index rather than a query somebody has to remember to run.
  eventId      String
  category     String

  voterId String

  createdAt DateTime @default(now())

  nomination Nomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([eventId, category, voterId])
  @@index([tenantId, nominationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Lead allocation (M7 tail)
//
// Allocation itself needs no new table: leads have an owner, User already
// carries the quota and capacity columns, and LeadAssignmentHistory already
// records who moved what and why. Those quota columns had never been read by
// anything — DistributionRule advertises `respectQuotas` and the assigner
// ignored it — so the work here is enforcement, not schema.
//
// The one genuinely new record is an agent asking for more work.
// ─────────────────────────────────────────────────────────────────────────────

enum AllocationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Withdrawn by the person who asked.
  CANCELLED
}

/// "I have run out of leads."
///
/// Approving one allocates immediately, in the same transaction, so a request
/// cannot sit approved with nothing handed over.
model AllocationRequest {
  id       String @id @default(cuid())
  tenantId String

  requesterId String
  /// How many they asked for. What they actually got is `allocatedCount`,
  /// which is smaller whenever the pool or their quota ran out first.
  requested   Int
  reason      String?

  status AllocationRequestStatus @default(PENDING)

  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  allocatedCount Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, requesterId, status])
}

/// Platform-wide operator settings, editable from the console.
///
/// Environment variables stay the source of *defaults*; a row here overrides
/// one at runtime without a redeploy. Keys are namespaced strings so adding a
/// setting is a data change, not a schema change.
model PlatformSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// CONVERSATION INTELLIGENCE — objection playbook, roleplay practice, coaching
//
// Built on the call-intelligence tables that already exist: Recording holds the
// audio, Transcript the text, AIAnalysis the structured insight and CallAudit
// the scorecard result. Nothing below duplicates those — it adds the three
// things they had no home for: what the workspace considers an objection, a
// rep practising against one, and a manager writing to the rep about a call.
// ─────────────────────────────────────────────────────────────────────────────

/// A workspace's objection playbook entry.
///
/// `triggerPhrases` is what the customer says; `recommendedResponses` is what
/// the workspace has decided a good answer sounds like. Both are the tenant's
/// own words, which is why matching against them is deterministic (see
/// src/lib/ai/callMetrics.ts) rather than asked of a model: an objection the
/// workspace wrote down should be found the same way every time, including on
/// a deployment with no model key at all.
model Objection {
  id                   String    @id @default(cuid())
  tenantId             String
  name                 String
  description          String?
  tags                 String[]  @default([])
  triggerPhrases       String[]  @default([])
  recommendedResponses String[]  @default([])
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String?
  updatedById          String?
  deletedAt            DateTime?

  matches ObjectionMatch[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

/// One playbook entry found in one call's transcript.
///
/// Rewritten wholesale each time the call is analysed, so a playbook edit
/// followed by a re-analysis produces the current answer rather than a union of
/// every answer the playbook has ever given.
model ObjectionMatch {
  id          String   @id @default(cuid())
  tenantId    String
  callId      String
  objectionId String
  /// The trigger phrase that fired, and the line it fired on. Kept so a manager
  /// can see *why* the call was flagged rather than trusting the label.
  phrase      String
  snippet     String
  /// Whether the rep's own turns after that line drew on the recommended
  /// response. A heuristic — see the note on `addressed` in callMetrics.ts.
  addressed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  call      Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  objection Objection @relation(fields: [objectionId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, callId, objectionId, phrase])
  @@index([tenantId, callId])
  @@index([tenantId, objectionId])
}

enum PracticeScenario {
  OPENER
  DISCOVERY
  OBJECTION
  CLOSE
}

enum PracticeStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// A rep's text-based mock call against an AI prospect.
///
/// `turns` is the whole conversation as an ordered array of
/// `{ role: "REP" | "PROSPECT", text, at }`. A row per turn would buy queries
/// nobody runs — a session is only ever read whole, to replay it or to score it.
model PracticeSession {
  id          String           @id @default(cuid())
  tenantId    String
  userId      String
  scenario    PracticeScenario
  /// Set when the scenario is OBJECTION: which playbook entry to rehearse.
  objectionId String?
  /// The persona and situation handed to the model, frozen at start so a later
  /// edit to the brief cannot change what an old session is scored against.
  brief       String
  turns       Json             @default("[]")
  status      PracticeStatus   @default(IN_PROGRESS)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  score PracticeScore?

  user User @relation("PracticeUser", fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, startedAt(sort: Desc)])
  @@index([tenantId, scenario, startedAt(sort: Desc)])
}

/// The rubric result for a finished practice session. One per session.
model PracticeScore {
  id           String         @id @default(cuid())
  tenantId     String
  sessionId    String         @unique
  status       AnalysisStatus @default(PENDING)
  overallScore Float?
  maxScore     Float?
  /// `[{ label, score, maxScore, comment }]` — the same shape CallAudit uses, so
  /// the score table renders both.
  rubricScores Json           @default("[]")
  strengths    Json           @default("[]")
  improvements Json           @default("[]")
  modelId      String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// A manager's written coaching on a call.
///
/// Deliberately not a comment on the AIAnalysis row: coaching is about the
/// conversation, and it must survive a re-analysis that replaces every field of
/// the model's verdict.
model CoachingNote {
  id         String    @id @default(cuid())
  tenantId   String
  callId     String
  authorId   String
  body       String
  /// Set when the rep marks the note as acted on. Null is the open state.
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  call   Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  author User @relation("CoachingAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, callId, createdAt(sort: Desc)])
  @@index([tenantId, authorId])
}
