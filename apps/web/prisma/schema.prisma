  @@unique([tenantId, holidayDate, name])
  @@index([tenantId, holidayDate])
}

model HrEmployeeDocument {
  id               String          @id @default(cuid())
  tenantId         String
  employeeId       String
  kind             String
  name             String
  number           String?
  storageKey       String?
  originalFilename String?
  contentType      String?
  sizeBytes        Int?
  sha256           String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  verifiedAt       DateTime?
  /// PENDING until a scanner returns a verdict. Download is gated on CLEAN, so a
  /// file that was never scanned — because the scanner was down — is never served.
  scanStatus       HrScanStatus    @default(PENDING)
  scanProvider     String?
  scannedAt        DateTime?
  /// Engine and signature-database version, so a past clean verdict can be
  /// re-judged when a signature set is later found to have missed something.
  scanSignature    String?
  quarantined      Boolean         @default(true)
  createdAt        DateTime        @default(now())
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, kind])
}

model HrWorkLocation {
  id                  String                         @id @default(cuid())
  tenantId            String
  name                String
  code                String?
  locationType        String                         @default("BRANCH_OFFICE")
  address             String?
  emirate             String?
  country             String                         @default("United Arab Emirates")
  latitude            Float
  longitude           Float
  radiusMeters        Int                            @default(150)
  maxAccuracyMeters   Int                            @default(100)
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
