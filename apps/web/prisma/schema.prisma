// ─────────────────────────────────────────────────────────────────────────────
// CALLS, RECORDINGS & AI ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

enum CallStatus {
  SCHEDULED
  RINGING
  IN_PROGRESS
  COMPLETED
  MISSED
  FAILED
  CANCELLED
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  VOICEMAIL
  WRONG_NUMBER
  CALLBACK_REQUESTED
  NOT_INTERESTED
  INTERESTED
  QUALIFIED
  CONVERTED
}

enum ConsentMethod {
  VERBAL
  WRITTEN
  ELECTRONIC
  PRE_AUTHORIZED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  INSUFFICIENT_DATA
}

model Call {
  id              String                 @id @default(cuid())
  tenantId        String
  leadId          String?
  contactId       String?
  accountId       String?
  campaignId      String?
  /**
   * Set when this call is a meeting held for an Event — the recording, consent,
   * transcript and AI summary pipeline is shared with ordinary calls.
   */
  eventId         String?
  callerId        String
  caller          User                   @relation("CallerUser", fields: [callerId], references: [id])
  direction       CommunicationDirection @default(OUTBOUND)
  status          CallStatus             @default(SCHEDULED)
  outcome         CallOutcome?
  externalCallId  String?
  providerName    String?
  callerNumber    String?
  recipientNumber String?
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSecs    Int?
  notes           String?
  followUpAt      DateTime?
  scriptId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  recording  Recording?
  consent    RecordingConsent?
  transcript Transcript?
  analysis   AIAnalysis?
  callAudits CallAudit[]

  objectionMatches ObjectionMatch[]
  coachingNotes    CoachingNote[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerName, externalCallId])
  @@index([tenantId, callerId, createdAt(sort: Desc)])
  @@index([tenantId, leadId, createdAt(sort: Desc)])
  @@index([tenantId, campaignId, createdAt(sort: Desc)])
  @@index([tenantId, eventId, createdAt(sort: Desc)])
  @@index([tenantId, status])
}

model Recording {
  id             String    @id @default(cuid())
  tenantId       String
  callId         String    @unique
  storageKey     String
  storageBucket  String?
  mimeType       String    @default("audio/webm")
  sizeBytes      Int?
  durationSecs   Int?
  encryptionKey  String?
  retainUntil    DateTime?
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, retainUntil])
}

model RecordingConsent {
  id             String         @id @default(cuid())
  tenantId       String
  callId         String         @unique
  consentGiven   Boolean
  method         ConsentMethod?
  consentedBy    String?
  consentVersion String?
  givenAt        DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime       @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, callId])
}

model Transcript {
  id         String   @id @default(cuid())
  tenantId   String
  callId     String   @unique
  content    String
  /// Speaker-attributed segments, when the provider diarises:
  /// `[{ speaker: "0", text: "...", startSec: 1.2 }]`. Empty when it does not —
  /// the flat `content` is always authoritative, this is an extra view of it.
  segments   Json     @default("[]")
  language   String   @default("en")
  provider   String?
  confidence Float?
  wordCount  Int?
  createdAt  DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, callId])
}

model AIAnalysis {
  id              String         @id @default(cuid())
  tenantId        String
  callId          String         @unique
  status          AnalysisStatus @default(PENDING)
  modelId         String?
  summary         String?
  clientNeeds     Json           @default("[]")
  objections      Json           @default("[]")
  commitments     Json           @default("[]")
  buyingSignals   Json           @default("[]")
  risks           Json           @default("[]")
  nextSteps       Json           @default("[]")
  /// Concrete things the rep committed to doing, distinct from `commitments`
  /// (what either side said) and `nextSteps` (the recommended play).
  actionItems     Json           @default("[]")
  /// Share of speech that was the rep, 0-1, computed from the transcript rather
  /// than asked of the model — a ratio a model guesses at is not a measurement.
  /// Null when the transcript carries no speaker attribution at all.
  talkRatio       Float?
  /// Which prompt produced this row. `modelId` says which model answered; this
  /// says what it was asked, so a summary can be explained after the prompt has
  /// moved on. Bumped by hand in src/lib/ai/analysis.ts.
  promptVersion   String?
  topicsDiscussed Json           @default("[]")
  topicsMissed    Json           @default("[]")
  sentiment       String?
  sentimentScore  Float?
  suggestedStatus String?
  complianceFlags Json           @default("[]")
  uncertainItems  Json           @default("[]")
  rawOutput       Json?
  humanCorrected  Boolean        @default(false)
  correctedById   String?
  correctedAt     DateTime?
  errorMessage    String?
  processingMs    Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, callId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL AUDIT & COACHING
// ─────────────────────────────────────────────────────────────────────────────

model AuditScorecard {
  id          String   @id @default(cuid())
  tenantId    String
  campaignId  String?
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  criteria AuditCriterion[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId])
}

model AuditCriterion {
  id          String  @id @default(cuid())
  tenantId    String
  scorecardId String
  label       String
  description String?
  weight      Float   @default(1.0)
  position    Int     @default(0)
  isRequired  Boolean @default(false)

  scorecard AuditScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scorecardId, position])
}

model CallAudit {
  id             String         @id @default(cuid())
  tenantId       String
  callId         String
  scorecardId    String
  overallScore   Float?
  maxScore       Float?
  status         AnalysisStatus @default(PENDING)
  criteriaScores Json           @default("[]")
  missedPoints   Json           @default("[]")
  strengths      Json           @default("[]")
  risks          Json           @default("[]")
  suggestions    Json           @default("[]")
  nextAction     String?
  errorMessage   String?
  humanReviewed  Boolean        @default(false)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, callId])
  @@index([tenantId, scorecardId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FOLLOW-UP TASKS (extends the existing Task model via a linking table)
// ─────────────────────────────────────────────────────────────────────────────

model FollowUpTask {
  id          String     @id @default(cuid())
  tenantId    String
  leadId      String?
  callId      String?
  campaignId  String?
  ownerId     String
  title       String
  description String?
  dueAt       DateTime
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(OPEN)
  completedAt DateTime?
  outcome     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerId, status, dueAt])
  @@index([tenantId, leadId])
  @@index([tenantId, callId])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTEGRATION CONNECTIONS
// ─────────────────────────────────────────────────────────────────────────────

model IntegrationConnection {
  id             String    @id @default(cuid())
  tenantId       String
  provider       String
  webhookKey     String    @unique @default(uuid())
  status         String    @default("DISCONNECTED")
  credentials    Json?
  scopes         String[]  @default([])
  externalUserId String?
  expiresAt      DateTime?
  refreshToken   String?
  metadata       Json      @default("{}")
  lastSyncAt     DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WEBHOOK EVENTS (idempotent processing)
// ─────────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id           String    @id @default(cuid())
  tenantId     String
  provider     String
  externalId   String
  eventType    String
  payload      Json
  processed    Boolean   @default(false)
  processedAt  DateTime?
  attempts     Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([provider, processed, createdAt])
