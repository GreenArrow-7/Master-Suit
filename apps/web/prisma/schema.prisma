// ─────────────────────────────────────────────────────────────────────────────
// TENANCY & ORGANIZATION STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id             String    @id @default(cuid())
  slug           String    @unique
  legalName      String
  displayName    String
  primaryDomain  String?
  status         String    @default("ACTIVE")
  planCode       String    @default("standard")
  dataRegion     String    @default("me-central-1")
  leadCeiling    Int       @default(1000000)
  industry       String?
  companySize    String?
  country        String?   @default("AE")
  timezone       String    @default("Asia/Dubai")
  currency       String    @default("AED")
  companyEmail   String?
  companyPhone   String?
  address        Json      @default("{}")
  logoUrl        String?
  maxUsers       Int?
  maxEmployees   Int?
  maxStorageMb   Int?
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  workspaceName  String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  settings              OrganizationSetting?
  users                 User[]
  branches              Branch[]
  regions               Region[]
  subscription          TenantSubscription?
  moduleEntitlements    ModuleEntitlement[]
  memberships           WorkspaceMembership[]
  employeeProfiles      EmployeeProfile[]
  platformSessions      PlatformSession[]
  platformAuditEvents   PlatformAuditEvent[]
  designations          Designation[]
  shifts                HrShift[]
  attendanceRecords     HrAttendanceRecord[]
  hrLeaveTypes          HrLeaveType[]
  hrLeaveRequests       HrLeaveRequest[]
  hrHolidays            HrHoliday[]
  hrDocuments           HrEmployeeDocument[]
  hrWorkLocations       HrWorkLocation[]
  hrLocationAssignments HrEmployeeLocationAssignment[]
  hrLeaveBalances       HrLeaveBalance[]
  hrChecklistTasks      HrChecklistTask[]
  hrOffboardingCases    HrOffboardingCase[]
  hrSettlementSnapshots HrSettlementSnapshot[]
  biometricConsents     BiometricConsent[]
  hrFaceTemplates       HrFaceTemplate[]
  hrAttendancePunches   HrAttendancePunch[]
  hrTemporaryRequests   HrTemporaryLocationRequest[]
  hrExceptionRequests   HrAttendanceExceptionRequest[]
  workspaceUsage        WorkspaceUsage[]
  billingEvents         BillingEvent[]

  invitations           WorkspaceInvitation[]

  @@index([status])
}

enum ModuleKey {
  HRMS
  SALES
}

enum SubscriptionState {
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
  CANCELED
}

model SubscriptionPlan {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  modules       ModuleKey[]
  seatLimit     Int
  storageMb     Int
  featureLimits Json        @default("{}")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  subscriptions TenantSubscription[]
  planModules   PlanModule[]
  planLimits    PlanLimit[]
}

model TenantSubscription {
  id                 String            @id @default(cuid())
  tenantId           String            @unique
  planId             String
  state              SubscriptionState @default(TRIAL)
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  externalCustomerId String?
  externalContractId String?
  canceledAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan     @relation(fields: [planId], references: [id])
  modules       SubscriptionModule[]
  billingEvents BillingEvent[]

  @@index([state, currentPeriodEnd])
}

model ModuleEntitlement {
  id        String            @id @default(cuid())
  tenantId  String
  module    ModuleKey
  state     SubscriptionState @default(TRIAL)
  limits    Json              @default("{}")
  startsAt  DateTime          @default(now())
  endsAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId, state])
}

model PlanModule {
  id        String           @id @default(cuid())
  planId    String
  module    ModuleKey
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, module])
}

model PlanLimit {
  id        String           @id @default(cuid())
  planId    String
  key       String
  value     Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model SubscriptionModule {
  id             String             @id @default(cuid())
  subscriptionId String
  module         ModuleKey
  state          SubscriptionState  @default(ACTIVE)
  limits         Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, module])
}

model WorkspaceUsage {
  id         String   @id @default(cuid())
  tenantId   String
  metric     String
  used       Int      @default(0)
  limit      Int?
  measuredAt DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric])
  @@index([tenantId, measuredAt])
}

model BillingEvent {
  id             String              @id @default(cuid())
  tenantId       String
  subscriptionId String?
  type           String
  amountMinor    Int?
  currency       String?
  externalId     String?
  metadata       Json                @default("{}")
  occurredAt     DateTime            @default(now())
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   TenantSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt(sort: Desc)])
}

model OrganizationSetting {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  productName       String   @default("Master App")
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String   @default("#2447C7")
  accentColor       String   @default("#0E7C66")
  emailFromName     String?
  emailFromAddress  String?
  defaultTimezone   String   @default("Asia/Dubai")
  defaultLocale     String   @default("en-AE")
  defaultCurrency   String   @default("AED")
  fiscalYearStart   Int      @default(1)
  terminology       Json     @default("{}")
  workingHours      Json     @default("{}")
  quietHours        Json     @default("{}")
  passwordPolicy    Json     @default("{}")
  sessionTtlMinutes Int      @default(480)
  mfaRequired       Boolean  @default(false)
  ipAllowlist       String[] @default([])
  retentionPolicy   Json     @default("{}")
  featureFlags      Json     @default("{}")
  /// Workspace overrides for the HR policy registry in src/services/hr/settings.ts.
  /// Only keys that differ from the statutory/product default are stored, so a
  /// default that changes in a release reaches every workspace that never
  /// overrode it.
  hrPolicy          Json     @default("{}")
  /// Administrator-chosen grid columns, keyed by object type ("LEAD": ["stage", ...]).
  /// Only the chosen order is stored; labels and rendering stay in
  /// src/lib/grid/columns.ts so a catalogue change reaches every workspace.
  gridColumns       Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Region {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String
  headUserId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Branch {
  id           String    @id @default(cuid())
  tenantId     String
  regionId     String?
  name         String
  code         String
  addressLine  String?
  city         String?
  country      String?
  timezone     String    @default("Asia/Dubai")
  workingHours Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id])
  teams  Team[]
  users  User[]

  @@unique([tenantId, code])
  @@index([tenantId, regionId])
}

model Territory {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String
  branchId    String?
  countries   String[]  @default([])
  states      String[]  @default([])
  cities      String[]  @default([])
  postalCodes String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Department {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  teams     Team[]
  employees EmployeeProfile[]

  @@unique([tenantId, code])
  invitations         WorkspaceInvitation[]

  @@index([tenantId])
}

model Team {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  code         String
  branchId     String?
  departmentId String?
  managerId    String?
  parentTeamId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  parentTeam Team?       @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams Team[]      @relation("TeamHierarchy")
  members    UserTeam[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@index([tenantId, managerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY, ROLES & PERMISSIONS
// ─────────────────────────────────────────────────────────────────────────────

/// A person's membership of one workspace: profile, role, placement, quotas.
///
/// Deliberately holds NO credentials. Authentication is PlatformUser's job and
/// PlatformUser's alone — see the note on that model. This row exists once per
/// workspace a person belongs to; their password exists once, globally.
model User {
  id                 String     @id @default(cuid())
  tenantId           String
  email              String
  emailVerifiedAt    DateTime?
  fullName           String
  displayName        String?
  phone              String?
  avatarUrl          String?
  employeeCode       String?
  jobTitle           String?
  status             UserStatus @default(INVITED)
  roleId             String
  branchId           String?
  regionId           String?
  managerId          String?
  timezone           String     @default("Asia/Dubai")
  locale             String     @default("en-AE")
  languages          String[]   @default([])
  skills             String[]   @default([])
  workingHours       Json       @default("{}")
  onLeaveUntil       DateTime?
  isAvailable        Boolean    @default(true)
  dailyLeadQuota     Int?
  weeklyLeadQuota    Int?
  monthlyLeadQuota   Int?
  activeLeadCapacity Int?
  notificationPrefs  Json       @default("{}")
  uiPreferences      Json       @default("{}")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  manager User?   @relation("UserHierarchy", fields: [managerId], references: [id])
  reports User[]  @relation("UserHierarchy")

  teams               UserTeam[]
  passwordResetTokens PasswordResetToken[]
  ownedLeads          Lead[]               @relation("LeadOwner")
  ownedOpps           Opportunity[]        @relation("OpportunityOwner")
  ownedAccounts       Account[]            @relation("AccountOwner")
  ownedContacts       Contact[]            @relation("ContactOwner")
  activities          Activity[]           @relation("ActivityOwner")
  tasks               Task[]               @relation("TaskOwner")
  tickets             Ticket[]             @relation("TicketAgent")
  campaigns           Campaign[]           @relation("CampaignOwner")
  notifications       Notification[]
  targets             EmployeeTarget[]
  calls               Call[]               @relation("CallerUser")
  workspaceMembership WorkspaceMembership?

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, roleId])
  @@index([tenantId, branchId])
  @@index([tenantId, managerId])
  @@index([email])
}

/// A person has one platform identity, regardless of how many customer
/// workspaces they belong to. Tenant-scoped User remains the Sales actor during
/// the additive migration and is linked through WorkspaceMembership.
/// The identity. One row per human, across every workspace they belong to, and
/// the single place a credential is stored.
///
/// `User` used to carry a duplicate passwordHash/mfaSecret/lockout set that had
/// to be kept in step by hand. It was not: the password-reset route wrote only
/// the User copy while login read only this one, so a reset silently did
/// nothing and a leaked password stayed valid. The duplicate columns are gone.
model PlatformUser {
  id                String       @id @default(cuid())
  email             String       @unique
  normalizedEmail   String       @unique
  passwordHash      String?
  fullName          String
  avatarUrl         String?
  phone             String?
  status            UserStatus   @default(INVITED)
  platformRole      PlatformRole @default(USER)
  emailVerifiedAt   DateTime?
  mfaEnabled        Boolean      @default(false)
  mfaSecret         String?
  mfaRecoveryCodes  String[]     @default([])
  failedLoginCount  Int          @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  memberships           WorkspaceMembership[]
  sessions              PlatformSession[]
  platformAuditEvents   PlatformAuditEvent[]   @relation("PlatformAuditActor")
  authenticationFactors AuthenticationFactor[]

  @@index([status, platformRole])
}

/// A pending invitation to join a workspace.
///
/// The only way to create a login. Before this existed, an administrator typed a
/// plaintext password into a form and communicated it out of band — so every new
/// account began life with a credential its administrator knew, and `INVITED`
/// was a status nothing ever set.
///
/// The token is stored hashed: a leaked database row must not be redeemable.
model WorkspaceInvitation {
  id              String    @id @default(cuid())
  tenantId        String
  /// Lower-cased at write time; the unique index below is what stops two open
  /// invitations racing each other into two memberships for one person.
  email           String
  fullName        String
  roleId          String
  /// Set when the invitation should also create an HR record on acceptance.
  employeeNumber  String?
  jobTitle        String?
  departmentId    String?
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  revokedReason   String?
  /// Bumped by a resend, so the audit trail shows how many were sent.
  sendCount       Int       @default(1)
  lastSentAt      DateTime  @default(now())
  invitedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// One open invitation per address per workspace. Accepted and revoked rows
  /// keep their history; `pendingKey` is null once either happens, and Postgres
  /// does not compare nulls, so the constraint only binds live invitations.
  pendingKey String?

  @@unique([tenantId, pendingKey])
  @@index([tenantId, expiresAt])
  @@index([email])
}

model WorkspaceMembership {
  id             String           @id @default(cuid())
  tenantId       String
  platformUserId String
  salesUserId    String?          @unique
  status         MembershipStatus @default(INVITED)
  isPrimaryAdmin Boolean          @default(false)
  roleSnapshot   String?
  invitedAt      DateTime         @default(now())
  joinedAt       DateTime?
  suspendedAt    DateTime?
  removedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformUser     PlatformUser      @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  salesUser        User?             @relation(fields: [salesUserId], references: [id], onDelete: SetNull)
  employee         EmployeeProfile?
  managedEmployees EmployeeProfile[] @relation("EmployeeManager")
  roles            MembershipRole[]

  @@unique([tenantId, platformUserId])
  @@index([platformUserId, status])
  @@index([tenantId, status])
}

/// Shared employee record. HRMS-specific records attach to this ID after the
/// HR data migration; login credentials never live on the employee record.
model EmployeeProfile {
  id                  String    @id @default(cuid())
  tenantId            String
  membershipId        String    @unique
  employeeNumber      String
  departmentCode      String?
  designation         String?
  departmentId        String?
  designationId       String?
  employmentStatus    String    @default("ACTIVE")
  employmentType      String?
  joinedOn            DateTime?
  exitedOn            DateTime?
  basicSalary         Decimal?  @db.Decimal(14, 2)
  totalSalary         Decimal?  @db.Decimal(14, 2)
  reraBrn             String?
  reraExpiry          DateTime?
  managerMembershipId String?
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant                  Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership              WorkspaceMembership            @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  manager                 WorkspaceMembership?           @relation("EmployeeManager", fields: [managerMembershipId], references: [id])
  department              Department?                    @relation(fields: [departmentId], references: [id])
  designationRecord       Designation?                   @relation(fields: [designationId], references: [id])
  attendanceRecords       HrAttendanceRecord[]
  leaveRequests           HrLeaveRequest[]               @relation("HrLeaveEmployee")
  leaveApprovals          HrLeaveRequest[]               @relation("HrLeaveApprover")
  leaveBalances           HrLeaveBalance[]
  documents               HrEmployeeDocument[]
  shifts                  HrEmployeeShift[]
  locationAssignments     HrEmployeeLocationAssignment[] @relation("HrLocationEmployee")
  assignedLocations       HrEmployeeLocationAssignment[] @relation("HrLocationAssigner")
  checklistTasks          HrChecklistTask[]              @relation("HrChecklistEmployee")
  completedChecklistTasks HrChecklistTask[]              @relation("HrChecklistCompleter")
  offboardingCases        HrOffboardingCase[]            @relation("HrOffboardingEmployee")
  startedOffboardingCases HrOffboardingCase[]            @relation("HrOffboardingStarter")
  settlementSnapshots     HrSettlementSnapshot[]
  biometricConsents       BiometricConsent[]
  faceTemplates           HrFaceTemplate[]
  attendancePunches       HrAttendancePunch[]
  temporaryRequests       HrTemporaryLocationRequest[]   @relation("HrTempRequester")
  temporaryApprovals      HrTemporaryLocationRequest[]   @relation("HrTempApprover")
  exceptionRequests       HrAttendanceExceptionRequest[] @relation("HrExceptionEmployee")
  exceptionManagerActions HrAttendanceExceptionRequest[] @relation("HrExceptionManager")
  exceptionHrActions      HrAttendanceExceptionRequest[] @relation("HrExceptionHr")

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, managerMembershipId])
}

model AuthenticationFactor {
