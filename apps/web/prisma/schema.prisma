  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  tenant              Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecords   HrAttendanceRecord[]
  attendancePunches   HrAttendancePunch[]
  temporaryRequests   HrTemporaryLocationRequest[]
  exceptionRequests   HrAttendanceExceptionRequest[]
  employeeAssignments HrEmployeeLocationAssignment[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, status, effectiveFrom, effectiveTo])
}

model HrEmployeeLocationAssignment {
  id               String           @id @default(cuid())
  tenantId         String
  employeeId       String
  locationId       String
  assignmentType   String           @default("PRIMARY")
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  checkInAllowed   Boolean          @default(true)
  checkOutAllowed  Boolean          @default(true)
  allowedDays      Int[]            @default([])
  allowedStartTime String?
  allowedEndTime   String?
  checkoutRule     String           @default("SAME_LOCATION")
  status           String           @default("ACTIVE")
  notes            String?
  assignedById     String?
