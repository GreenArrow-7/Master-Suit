  @@index([tenantId, nextFollowUpAt])
  @@index([tenantId, slaState, slaDueAt])
  @@index([tenantId, branchId, teamId])
  @@index([tenantId, score(sort: Desc)])
  @@index([tenantId, deletedAt])
  /// The list view: every cursor page orders by (updatedAt DESC, id DESC).
  @@index([tenantId, updatedAt(sort: Desc), id(sort: Desc)])
}

model LeadCustomFieldDefinition {
