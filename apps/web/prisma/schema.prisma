/// A person's membership of one workspace: profile, role, placement, quotas.
///
/// Deliberately holds NO credentials. Authentication is PlatformUser's job and
/// PlatformUser's alone — see the note on that model. This row exists once per
/// workspace a person belongs to; their password exists once, globally.
model User {
  id                 String     @id @default(cuid())
  tenantId           String
  email              String
  emailVerifiedAt    DateTime?
  fullName           String
  displayName        String?
  phone              String?
  avatarUrl          String?
  employeeCode       String?
  jobTitle           String?
  status             UserStatus @default(INVITED)
  roleId             String
  branchId           String?
  regionId           String?
  managerId          String?
  timezone           String     @default("Asia/Dubai")
  locale             String     @default("en-AE")
  languages          String[]   @default([])
  skills             String[]   @default([])
  workingHours       Json       @default("{}")
  onLeaveUntil       DateTime?
  isAvailable        Boolean    @default(true)
  dailyLeadQuota     Int?
  weeklyLeadQuota    Int?
  monthlyLeadQuota   Int?
  activeLeadCapacity Int?
  notificationPrefs  Json       @default("{}")
  uiPreferences      Json       @default("{}")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  manager User?   @relation("UserHierarchy", fields: [managerId], references: [id])
  reports User[]  @relation("UserHierarchy")

  teams               UserTeam[]
  passwordResetTokens PasswordResetToken[]
  ownedLeads          Lead[]                @relation("LeadOwner")
  ownedConversations  Conversation[]        @relation("ConversationOwner")
  metaRoutings        MetaLeadFormRouting[] @relation("MetaRoutingOwner")
  socialComments      SocialComment[]       @relation("SocialCommentOwner")
  ownedOpps           Opportunity[]         @relation("OpportunityOwner")
  ownedAccounts       Account[]             @relation("AccountOwner")
  ownedContacts       Contact[]             @relation("ContactOwner")
  activities          Activity[]            @relation("ActivityOwner")
  tasks               Task[]                @relation("TaskOwner")
  tickets             Ticket[]              @relation("TicketAgent")
  campaigns           Campaign[]            @relation("CampaignOwner")
  notifications       Notification[]
  targets             EmployeeTarget[]
  calls               Call[]                @relation("CallerUser")
  practiceSessions    PracticeSession[]     @relation("PracticeUser")
  coachingNotes       CoachingNote[]        @relation("CoachingAuthor")
  workspaceMembership WorkspaceMembership?

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, roleId])
  @@index([tenantId, branchId])
  @@index([tenantId, managerId])
  @@index([email])
}

/// A person has one platform identity, regardless of how many customer
/// workspaces they belong to. Tenant-scoped User remains the Sales actor during
/// the additive migration and is linked through WorkspaceMembership.
/// The identity. One row per human, across every workspace they belong to, and
/// the single place a credential is stored.
///
/// `User` used to carry a duplicate passwordHash/mfaSecret/lockout set that had
/// to be kept in step by hand. It was not: the password-reset route wrote only
/// the User copy while login read only this one, so a reset silently did
/// nothing and a leaked password stayed valid. The duplicate columns are gone.
model PlatformUser {
  id                String       @id @default(cuid())
  email             String       @unique
  normalizedEmail   String       @unique
  passwordHash      String?
  fullName          String
  avatarUrl         String?
  phone             String?
  status            UserStatus   @default(INVITED)
  platformRole      PlatformRole @default(USER)
  emailVerifiedAt   DateTime?
  mfaEnabled        Boolean      @default(false)
  mfaSecret         String?
  mfaRecoveryCodes  String[]     @default([])
  failedLoginCount  Int          @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  memberships           WorkspaceMembership[]
  sessions              PlatformSession[]
  platformAuditEvents   PlatformAuditEvent[]   @relation("PlatformAuditActor")
  authenticationFactors AuthenticationFactor[]

  @@index([status, platformRole])
}

/// A pending invitation to join a workspace.
///
/// The only way to create a login. Before this existed, an administrator typed a
/// plaintext password into a form and communicated it out of band — so every new
/// account began life with a credential its administrator knew, and `INVITED`
/// was a status nothing ever set.
///
/// The token is stored hashed: a leaked database row must not be redeemable.
model WorkspaceInvitation {
  id             String    @id @default(cuid())
  tenantId       String
  /// Lower-cased at write time; the unique index below is what stops two open
  /// invitations racing each other into two memberships for one person.
  email          String
  fullName       String
  roleId         String
  /// Set when the invitation should also create an HR record on acceptance.
  employeeNumber String?
  jobTitle       String?
  departmentId   String?
  /**
   * Set when the invitation came from a hired candidate. Carried onto the
   * employee record at acceptance so the hire stays traceable to the
   * application it came from — §109.
   */
  candidateId    String?
  /**
   * Agreed start date from the accepted offer, used instead of "today" on acceptance.
   */
  joiningDate    DateTime?
  /**
   * Full-time, contract, and so on. Carried from the invitation form, which
   * asked for it and then had it dropped: the POST schema did not declare the
   * field, so zod stripped it before anyone downstream could store it.
   */
  employmentType String?
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  /// Bumped by a resend, so the audit trail shows how many were sent.
  sendCount      Int       @default(1)
  lastSentAt     DateTime  @default(now())
  invitedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// One open invitation per address per workspace. Accepted and revoked rows
  /// keep their history; `pendingKey` is null once either happens, and Postgres
  /// does not compare nulls, so the constraint only binds live invitations.
  pendingKey String?

  @@unique([tenantId, pendingKey])
  @@index([tenantId, expiresAt])
  @@index([email])
}

model WorkspaceMembership {
  id             String           @id @default(cuid())
  tenantId       String
  platformUserId String
  salesUserId    String?          @unique
  status         MembershipStatus @default(INVITED)
  isPrimaryAdmin Boolean          @default(false)
  roleSnapshot   String?
  invitedAt      DateTime         @default(now())
  joinedAt       DateTime?
  suspendedAt    DateTime?
  removedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformUser     PlatformUser      @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  salesUser        User?             @relation(fields: [salesUserId], references: [id], onDelete: SetNull)
  employee         EmployeeProfile?
  managedEmployees EmployeeProfile[] @relation("EmployeeManager")
  roles            MembershipRole[]

  @@unique([tenantId, platformUserId])
  @@index([platformUserId, status])
  @@index([tenantId, status])
}

/// Shared employee record. HRMS-specific records attach to this ID after the
/// HR data migration; login credentials never live on the employee record.
model EmployeeProfile {
  id                  String    @id @default(cuid())
  tenantId            String
  membershipId        String    @unique
  employeeNumber      String
  departmentCode      String?
  designation         String?
  departmentId        String?
  designationId       String?
  employmentStatus    String    @default("ACTIVE")
  employmentType      String?
  joinedOn            DateTime?
  exitedOn            DateTime?
  basicSalary         Decimal?  @db.Decimal(14, 2)
  totalSalary         Decimal?  @db.Decimal(14, 2)
  // Where the salary is actually sent. `wpsPersonId` is the MOL/labour-card
  // identifier the UAE Wage Protection System keys an employee on; `bankAgentId`
  // is the receiving bank's routing code. Both are needed to produce a SIF, and
  // an employee missing either is reported by the export rather than skipped.
  iban                String?
  bankName            String?
  bankAgentId         String?
  wpsPersonId         String?
  reraBrn             String?
  reraExpiry          DateTime?
  managerMembershipId String?
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant                    Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership                WorkspaceMembership            @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  manager                   WorkspaceMembership?           @relation("EmployeeManager", fields: [managerMembershipId], references: [id])
  department                Department?                    @relation(fields: [departmentId], references: [id])
  designationRecord         Designation?                   @relation(fields: [designationId], references: [id])
  attendanceRecords         HrAttendanceRecord[]
  leaveRequests             HrLeaveRequest[]               @relation("HrLeaveEmployee")
  leaveApprovals            HrLeaveRequest[]               @relation("HrLeaveApprover")
  leaveBalances             HrLeaveBalance[]
  documents                 HrEmployeeDocument[]
  shifts                    HrEmployeeShift[]
  locationAssignments       HrEmployeeLocationAssignment[] @relation("HrLocationEmployee")
  assignedLocations         HrEmployeeLocationAssignment[] @relation("HrLocationAssigner")
  checklistTasks            HrChecklistTask[]              @relation("HrChecklistEmployee")
  completedChecklistTasks   HrChecklistTask[]              @relation("HrChecklistCompleter")
  offboardingCases          HrOffboardingCase[]            @relation("HrOffboardingEmployee")
  startedOffboardingCases   HrOffboardingCase[]            @relation("HrOffboardingStarter")
  settlementSnapshots       HrSettlementSnapshot[]
  biometricConsents         BiometricConsent[]
  faceTemplates             HrFaceTemplate[]
  attendancePunches         HrAttendancePunch[]
  temporaryRequests         HrTemporaryLocationRequest[]   @relation("HrTempRequester")
  temporaryApprovals        HrTemporaryLocationRequest[]   @relation("HrTempApprover")
  exceptionRequests         HrAttendanceExceptionRequest[] @relation("HrExceptionEmployee")
  exceptionManagerActions   HrAttendanceExceptionRequest[] @relation("HrExceptionManager")
  exceptionHrActions        HrAttendanceExceptionRequest[] @relation("HrExceptionHr")
  overtimeClaims            HrOvertimeRequest[]            @relation("HrOvertimeEmployee")
  overtimeRaised            HrOvertimeRequest[]            @relation("HrOvertimeRequester")
  overtimeDecisions         HrOvertimeRequest[]            @relation("HrOvertimeApprover")
  compensations             HrCompensation[]               @relation("HrCompensationEmployee")
  payslips                  HrPayslip[]                    @relation("HrPayslipEmployee")
  payrollAdjustments        HrPayrollAdjustment[]          @relation("HrAdjustmentEmployee")
  payrollRunsPrepared       HrPayrollRun[]                 @relation("HrPayrollPreparer")
  payrollRunsApproved       HrPayrollRun[]                 @relation("HrPayrollApprover")
  rosterEntries             HrRosterEntry[]                @relation("HrRosterEmployee")
  shiftChangesRaised        HrShiftChangeRequest[]         @relation("HrShiftChangeRequester")
  shiftChangesAsCounterpart HrShiftChangeRequest[]         @relation("HrShiftChangeCounterpart")
  shiftChangeDecisions      HrShiftChangeRequest[]         @relation("HrShiftChangeApprover")
  requisitionsManaged       HrRequisition[]                @relation("HrRequisitionHiringManager")
  requisitionsRecruited     HrRequisition[]                @relation("HrRequisitionRecruiter")
  requisitionsApproved      HrRequisition[]                @relation("HrRequisitionApprover")
  interviewFeedbackGiven    HrInterviewFeedback[]          @relation("HrInterviewFeedbackAuthor")
  offersApproved            HrOffer[]                      @relation("HrOfferApprover")
  goals                     HrGoal[]                       @relation("HrGoalEmployee")
  reviews                   HrReview[]                     @relation("HrReviewEmployee")
  reviewsAsManager          HrReview[]                     @relation("HrReviewManager")
  reviewsCalibrated         HrReview[]                     @relation("HrReviewCalibrator")
  pips                      HrPip[]                        @relation("HrPipEmployee")
  pipsAsManager             HrPip[]                        @relation("HrPipManager")
  /**
   * The application this employee was hired from, when they came through the ATS — §109.
   */
  hiredFromCandidateId      String?
  hiredFromCandidate        HrCandidate?                   @relation("HrCandidateHire", fields: [hiredFromCandidateId], references: [id])

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, managerMembershipId])
}

model AuthenticationFactor {
  id             String       @id @default(cuid())
  platformUserId String
  type           String
  secret         String?
  verifiedAt     DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, type])
}

model MembershipRole {
  id               String              @id @default(cuid())
  tenantId         String
  membershipId     String
  roleId           String
  scopeType        String              @default("ORGANIZATION")
  scopeId          String?
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  status           String              @default("ACTIVE")
  assignedById     String?
  revokedById      String?
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime            @default(now())
  membership       WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role             Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([tenantId, roleId])
  @@index([tenantId, membershipId, status, effectiveFrom, effectiveTo])
}

model Designation {
  id          String            @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   EmployeeProfile[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

model HrShift {
  id               String                 @id @default(cuid())
  tenantId         String
  name             String
  code             String
  startTime        String
  endTime          String
  workingDays      Int[]                  @default([])
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees        HrEmployeeShift[]
  rosterEntries    HrRosterEntry[]
  requestedInSwaps HrShiftChangeRequest[] @relation("HrShiftChangeRequestedShift")

  @@unique([tenantId, code])
}

model HrEmployeeShift {
  id          String          @id @default(cuid())
  tenantId    String
  employeeId  String
  shiftId     String
  effectiveOn DateTime
  endsOn      DateTime?
  employee    EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift       HrShift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, effectiveOn])
}

/**
 * A claim on paid overtime, whether the server noticed it or a person asked for it.
 * One row per employee per day per source. The unique constraint is the whole
 * idempotency story: re-running detection over a week that was already scanned
 * updates the minutes on the existing DETECTED row instead of stacking a second
 * claim on the same day, and an employee cannot file two REQUESTED claims for
 * one date. Detection and a manual request coexist deliberately — the manager
 * needs to see both "the clock says 90 minutes" and "he says he worked 120".
 */
model HrOvertimeRequest {
  id            String           @id @default(cuid())
  tenantId      String
  employeeId    String
  workDate      DateTime
  minutes       Int
  kind          HrOvertimeKind
  source        HrOvertimeSource
  status        HrOvertimeStatus @default(PENDING)
  reason        String?
  /**
   * Resolved when the claim is approved, never read live afterwards. A workspace
   * that lowers its weekend rate in March must not restate February's approved
   * overtime — §106. Null while pending, because no rate has been committed yet.
   */
  multiplier    Float?
  /**
   * Taken as time off in lieu instead of pay, so payroll skips it.
   */
  compensatory  Boolean          @default(false)
  requestedById String?
  approverId    String?
  decidedAt     DateTime?
  decisionNote  String?
  /**
   * Set when a payroll run consumes the row. A locked claim cannot be edited,
   * re-decided or cancelled — otherwise a payslip already issued stops
   * reconciling against the hours behind it.
   */
  lockedAt      DateTime?
  payrollRunId  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      EmployeeProfile  @relation("HrOvertimeEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy   EmployeeProfile? @relation("HrOvertimeRequester", fields: [requestedById], references: [id])
  approver      EmployeeProfile? @relation("HrOvertimeApprover", fields: [approverId], references: [id])

  @@unique([tenantId, employeeId, workDate, source])
  @@index([tenantId, status, workDate])
  @@index([tenantId, employeeId, workDate])
}

/**
 * Effective-dated pay. A raise is a new row, never an edit.
 * `EmployeeProfile.basicSalary` already existed and is mutable, which makes it
 * useless for answering "what was this person earning in March" — and payroll,
 * gratuity and any variance report all have to answer exactly that. This table
 * is the history; the profile columns stay as the current-value convenience the
 * rest of the app already reads.
 */
model HrCompensation {
  id             String          @id @default(cuid())
  tenantId       String
  employeeId     String
  effectiveFrom  DateTime
  basic          Decimal         @db.Decimal(14, 2)
  housing        Decimal         @default(0) @db.Decimal(14, 2)
  transport      Decimal         @default(0) @db.Decimal(14, 2)
  otherAllowance Decimal         @default(0) @db.Decimal(14, 2)
  currency       String          @default("AED")
  changeReason   String?
  createdById    String?
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       EmployeeProfile @relation("HrCompensationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  // One salary per person per effective date: two rows starting the same day
  // have no defined winner, and payroll would silently pick one.
  @@unique([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, employeeId, effectiveFrom])
}

model HrPayrollRun {
  id             String           @id @default(cuid())
  tenantId       String
  periodStart    DateTime
  periodEnd      DateTime
  status         HrPayrollStatus  @default(DRAFT)
  currency       String           @default("AED")
  /**
   * The resolved HR policy at calculation time. Stored whole rather than as a
   * version string so a payslip stays re-derivable after someone edits the
   * rates — the same reason settlement snapshots carry theirs.
   */
  policySnapshot Json?
  note           String?
  grossTotal     Decimal          @default(0) @db.Decimal(16, 2)
  netTotal       Decimal          @default(0) @db.Decimal(16, 2)
  calculatedAt   DateTime?
  preparedById   String?
  approvedById   String?
  approvedAt     DateTime?
  lockedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preparedBy     EmployeeProfile? @relation("HrPayrollPreparer", fields: [preparedById], references: [id])
  approvedBy     EmployeeProfile? @relation("HrPayrollApprover", fields: [approvedById], references: [id])
  payslips       HrPayslip[]

  // One run per period. Paying March twice is the failure this prevents.
  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId, status, periodStart])
}

model HrPayslip {
  id              String   @id @default(cuid())
  tenantId        String
  runId           String
  employeeId      String
  currency        String   @default("AED")
  basic           Decimal  @db.Decimal(14, 2)
  grossEarnings   Decimal  @db.Decimal(14, 2)
  totalDeductions Decimal  @db.Decimal(14, 2)
  netPay          Decimal  @db.Decimal(14, 2)
  workedDays      Float    @default(0)
  unpaidDays      Float    @default(0)
  overtimeMinutes Int      @default(0)
  /**
   * Every input the figures came from, so the breakdown survives a recalculation elsewhere.
   */
  inputs          Json
  /**
   * The IBAN as it stood when the run was calculated; a later bank change must not rewrite a past transfer.
   */
  ibanSnapshot    String?
  createdAt       DateTime @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run      HrPayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee EmployeeProfile @relation("HrPayslipEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  lines    HrPayslipLine[]

  @@unique([tenantId, runId, employeeId])
  @@index([tenantId, employeeId])
}

model HrPayslipLine {
  id        String             @id @default(cuid())
  tenantId  String
  payslipId String
  code      String
  label     String
  kind      HrPayComponentKind
  amount    Decimal            @db.Decimal(14, 2)
  sortOrder Int                @default(0)
  payslip   HrPayslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, payslipId])
}

/**
 * A one-off addition or deduction: bonus, commission, reimbursement, loan
 * instalment, correction.
 * Kept out of the payslip lines it eventually produces so it can be entered and
 * audited before a run exists, and so a run recalculated in DRAFT picks it up
 * without anybody re-keying it.
 */
model HrPayrollAdjustment {
  id              String             @id @default(cuid())
  tenantId        String
  employeeId      String
  effectiveOn     DateTime
  code            String
  label           String
  kind            HrPayComponentKind
  amount          Decimal            @db.Decimal(14, 2)
  reason          String?
  /**
   * Set once a run has consumed it, so the same bonus cannot be paid in two months.
   */
  consumedByRunId String?
  createdById     String?
  createdAt       DateTime           @default(now())
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        EmployeeProfile    @relation("HrAdjustmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, effectiveOn])
  @@index([tenantId, consumedByRunId])
}

/**
 * One person, one shift, one date.
 * Distinct from `HrEmployeeShift`, which is the *standing* assignment — "Amina
 * works the early shift from March" — and cannot express next Tuesday only.
 * Overtime detection reads the standing assignment; a roster entry is what a
 * manager actually publishes, and what a swap moves.
 * The unique key allows two different shifts on one day (a split shift) while
 * refusing the same shift twice. Genuine time overlap between two different
 * shifts is caught in the service, because it needs the shift times to decide.
 */
model HrRosterEntry {
  id                  String                 @id @default(cuid())
  tenantId            String
  employeeId          String
  shiftId             String
  workDate            DateTime
  source              HrRosterSource         @default(ROSTER)
  note                String?
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee            EmployeeProfile        @relation("HrRosterEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  shift               HrShift                @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  changeRequests      HrShiftChangeRequest[] @relation("HrShiftChangeEntry")
  counterpartRequests HrShiftChangeRequest[] @relation("HrShiftChangeCounterpartEntry")

  @@unique([tenantId, employeeId, workDate, shiftId])
  @@index([tenantId, workDate])
  @@index([tenantId, employeeId, workDate])
}

/**
 * An employee asking for a rostered day to change: onto a different shift, or
 * swapped with a named colleague.
 * A swap needs both sides recorded before the decision, because approving it
 * moves two entries at once and both must still exist and still be theirs.
 */
model HrShiftChangeRequest {
  id                 String              @id @default(cuid())
  tenantId           String
  kind               HrShiftChangeKind
  requesterId        String
  entryId            String
  /**
   * CHANGE: the shift being asked for.
   */
  requestedShiftId   String?
  /**
   * SWAP: the colleague and the day of theirs being swapped into.
   */
  counterpartId      String?
  counterpartEntryId String?
  reason             String
  status             HrShiftChangeStatus @default(PENDING)
  approverId         String?
  decidedAt          DateTime?
  decisionNote       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester        EmployeeProfile  @relation("HrShiftChangeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  counterpart      EmployeeProfile? @relation("HrShiftChangeCounterpart", fields: [counterpartId], references: [id])
  approver         EmployeeProfile? @relation("HrShiftChangeApprover", fields: [approverId], references: [id])
  entry            HrRosterEntry    @relation("HrShiftChangeEntry", fields: [entryId], references: [id], onDelete: Cascade)
  counterpartEntry HrRosterEntry?   @relation("HrShiftChangeCounterpartEntry", fields: [counterpartEntryId], references: [id])
  requestedShift   HrShift?         @relation("HrShiftChangeRequestedShift", fields: [requestedShiftId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, requesterId])
}

model HrReviewCycle {
  id                 String        @id @default(cuid())
  tenantId           String
  name               String
  type               HrCycleType   @default(ANNUAL)
  periodStart        DateTime
  periodEnd          DateTime
  selfReviewDueAt    DateTime?
  managerReviewDueAt DateTime?
  status             HrCycleStatus @default(DRAFT)
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews            HrReview[]
  goals              HrGoal[]

  @@unique([tenantId, name])
  @@index([tenantId, status, periodStart])
}

/**
 * An objective with a weight.
 * Weights are checked against 100 across a cycle rather than stored as a
 * percentage of anything: a goal set carrying 140% of weight is a rating nobody
 * can defend, and it is only detectable by looking at the set.
 */
model HrGoal {
  id          String       @id @default(cuid())
  tenantId    String
  employeeId  String
  cycleId     String?
  title       String
  description String?
  metric      String?
  target      String?
  weight      Int          @default(0)
  dueOn       DateTime?
  progress    Int          @default(0)
  status      HrGoalStatus @default(ACTIVE)
  evidence    String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee EmployeeProfile @relation("HrGoalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  cycle    HrReviewCycle?  @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId, cycleId])
}

/**
 * A configurable competency framework. Seeded per workspace, editable by HR.
 */
model HrCompetency {
  id          String                    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean                   @default(true)
  sortOrder   Int                       @default(0)
  createdAt   DateTime                  @default(now())
  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scores      HrReviewCompetencyScore[]

  @@unique([tenantId, name])
}

model HrReview {
  id                  String         @id @default(cuid())
  tenantId            String
  cycleId             String
  employeeId          String
  managerId           String?
  status              HrReviewStatus @default(PENDING_SELF)
  selfComments        String?
  selfRating          Int?
  selfSubmittedAt     DateTime?
  managerComments     String?
  managerRating       Int?
  managerSubmittedAt  DateTime?
  /**
   * Set during calibration, which may move a rating away from the manager's.
   */
  finalRating         Int?
  calibratedById      String?
  calibratedAt        DateTime?
  calibrationNote     String?
  acknowledgedAt      DateTime?
  acknowledgementNote String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle            HrReviewCycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee         EmployeeProfile           @relation("HrReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager          EmployeeProfile?          @relation("HrReviewManager", fields: [managerId], references: [id])
  calibratedBy     EmployeeProfile?          @relation("HrReviewCalibrator", fields: [calibratedById], references: [id])
  competencyScores HrReviewCompetencyScore[]

  // One review per person per cycle.
  @@unique([tenantId, cycleId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

model HrReviewCompetencyScore {
  id           String  @id @default(cuid())
  tenantId     String
  reviewId     String
  competencyId String
  selfScore    Int?
  managerScore Int?
  comment      String?

  review     HrReview     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  competency HrCompetency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reviewId, competencyId])
}

/**
 * A performance improvement plan.
 * Modelled with checkpoints rather than a single end date because a PIP whose
 * only evidence is its outcome is not a process anyone can defend at a tribunal.
 */
model HrPip {
  id                   String      @id @default(cuid())
  tenantId             String
  employeeId           String
  managerId            String?
  objective            String
  expectedImprovements String
  startsOn             DateTime
  endsOn               DateTime
  status               HrPipStatus @default(DRAFT)
  outcome              String?
  acknowledgedAt       DateTime?
  acknowledgementNote  String?
  closedAt             DateTime?
  createdById          String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    EmployeeProfile   @relation("HrPipEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager     EmployeeProfile?  @relation("HrPipManager", fields: [managerId], references: [id])
  checkpoints HrPipCheckpoint[]

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

model HrPipCheckpoint {
  id             String    @id @default(cuid())
  tenantId       String
  pipId          String
  dueOn          DateTime
  expectation    String
  managerComment String?
  met            Boolean?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  pip            HrPip     @relation(fields: [pipId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, pipId, dueOn])
}

/**
 * An approved need to hire: the thing a vacancy and its candidates hang off.
 */
model HrRequisition {
  id              String              @id @default(cuid())
  tenantId        String
  title           String
  departmentId    String?
  hiringManagerId String?
  recruiterId     String?
  openings        Int                 @default(1)
  employmentType  String?
  locationId      String?
  /**
   * Salary band. Reading it needs `recruitment:VIEW_SENSITIVE_FIELDS`, not merely reaching the requisition.
   */
  salaryMin       Decimal?            @db.Decimal(14, 2)
  salaryMax       Decimal?            @db.Decimal(14, 2)
  currency        String              @default("AED")
  description     String?
  skills          String[]            @default([])
  reason          String?
  /**
   * Whether the vacancy is advertised outside the company.
   */
  isInternal      Boolean             @default(false)
  status          HrRequisitionStatus @default(DRAFT)
  approvedById    String?
  approvedAt      DateTime?
  decisionNote    String?
  closedAt        DateTime?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department?      @relation(fields: [departmentId], references: [id])
  location      HrWorkLocation?  @relation(fields: [locationId], references: [id])
  hiringManager EmployeeProfile? @relation("HrRequisitionHiringManager", fields: [hiringManagerId], references: [id])
  recruiter     EmployeeProfile? @relation("HrRequisitionRecruiter", fields: [recruiterId], references: [id])
  approver      EmployeeProfile? @relation("HrRequisitionApprover", fields: [approvedById], references: [id])
  candidates    HrCandidate[]

  @@index([tenantId, status, createdAt])
}

/**
 * One person's application to one requisition.
 * A person applying to two roles is two rows, which is why the identity fields
 * repeat. The alternative — a person table plus an application table — buys
 * de-duplication the product does not need yet and costs a join on every
 * pipeline read. The unique key is what actually matters: nobody applies to the
 * same requisition twice.
 */
model HrCandidate {
  id               String           @id @default(cuid())
  tenantId         String
  requisitionId    String
  fullName         String
  email            String
  phone            String?
  source           String?
  experienceYears  Float?
  skills           String[]         @default([])
  /**
   * CV, held in the same secure store as employee documents.
   */
  resumeDocumentId String?
  notes            String?
  stage            HrCandidateStage @default(APPLIED)
  rejectionReason  String?
  /**
   * Set when the hire is actioned; the employee row appears when the invitation is accepted.
   */
  invitationId     String?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requisition HrRequisition           @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stageEvents HrCandidateStageEvent[]
  interviews  HrInterview[]
  offers      HrOffer[]
  /**
   * Back-reference from the employee this candidate became — §109 traceability.
   */
  employees   EmployeeProfile[]       @relation("HrCandidateHire")

  @@unique([tenantId, requisitionId, email])
  @@index([tenantId, stage])
  @@index([tenantId, requisitionId, stage])
}

/**
 * Every pipeline move, so time-to-hire and stage conversion are derivable.
 */
model HrCandidateStageEvent {
  id          String            @id @default(cuid())
  tenantId    String
  candidateId String
  fromStage   HrCandidateStage?
  toStage     HrCandidateStage
  note        String?
  changedById String?
  createdAt   DateTime          @default(now())
  candidate   HrCandidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidateId, createdAt])
}

model HrInterview {
  id              String            @id @default(cuid())
  tenantId        String
  candidateId     String
  scheduledAt     DateTime
  durationMinutes Int               @default(60)
  type            HrInterviewType   @default(VIDEO)
  status          HrInterviewStatus @default(SCHEDULED)
  location        String?
  /**
   * Employee ids on the panel. Feedback is one row per interviewer.
   */
  panelIds        String[]          @default([])
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate HrCandidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  feedback  HrInterviewFeedback[]

  @@index([tenantId, scheduledAt])
  @@index([tenantId, candidateId])
}

/**
 * One interviewer's scorecard.
 */
model HrInterviewFeedback {
  id             String           @id @default(cuid())
  tenantId       String
  interviewId    String
  interviewerId  String
  rating         Int
  recommendation HrRecommendation
  /**
   * Per-competency scores, so a scorecard can be reshaped without a migration.
   */
  scores         Json             @default("{}")
  notes          String?
  createdAt      DateTime         @default(now())

  interview   HrInterview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer EmployeeProfile @relation("HrInterviewFeedbackAuthor", fields: [interviewerId], references: [id], onDelete: Cascade)

  // One scorecard per interviewer per interview; a second submission edits the first.

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, interviewId, interviewerId])
  @@index([tenantId, interviewId])
}

/**
 * An offer, versioned by row.
 * A renegotiated offer is a new version rather than an edit, so what the
 * candidate was actually sent stays readable after the terms move.
 */
model HrOffer {
  id             String        @id @default(cuid())
  tenantId       String
  candidateId    String
  version        Int           @default(1)
  basic          Decimal       @db.Decimal(14, 2)
  housing        Decimal       @default(0) @db.Decimal(14, 2)
  transport      Decimal       @default(0) @db.Decimal(14, 2)
  otherAllowance Decimal       @default(0) @db.Decimal(14, 2)
  currency       String        @default("AED")
  joiningDate    DateTime
  expiresAt      DateTime?
  status         HrOfferStatus @default(DRAFT)
  notes          String?
  approvedById   String?
  approvedAt     DateTime?
  decisionNote   String?
  respondedAt    DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate HrCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  approver  EmployeeProfile? @relation("HrOfferApprover", fields: [approvedById], references: [id])

  @@unique([tenantId, candidateId, version])
  @@index([tenantId, status])
}

model HrAttendanceRecord {
  id          String             @id @default(cuid())
  tenantId    String
  employeeId  String
  workDate    DateTime
  checkInAt   DateTime?
  checkOutAt  DateTime?
  status      HrAttendanceStatus @default(PRESENT)
  workMinutes Int?
  locationId  String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    EmployeeProfile    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location    HrWorkLocation?    @relation(fields: [locationId], references: [id])

  @@unique([tenantId, employeeId, workDate])
  @@index([tenantId, workDate, status])
}

model HrLeaveType {
  id               String           @id @default(cuid())
  tenantId         String
  name             String
  code             String
  annualAllowance  Float            @default(0)
  paid             Boolean          @default(true)
  accrues          Boolean          @default(false)
  maxCarryForward  Float            @default(0)
  requiresDocument Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests         HrLeaveRequest[]
  balances         HrLeaveBalance[]

  @@unique([tenantId, code])
}

model HrLeaveRequest {
  id            String           @id @default(cuid())
  tenantId      String
  employeeId    String
  leaveTypeId   String
  startDate     DateTime
  endDate       DateTime
  days          Float
  halfDay       Boolean          @default(false)
  reason        String?
  documentId    String?
  status        HrLeaveStatus    @default(PENDING)
  approverId    String?
  decidedAt     DateTime?
  decisionNote  String?
  cancelledAt   DateTime?
  cancelledById String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      EmployeeProfile  @relation("HrLeaveEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     HrLeaveType      @relation(fields: [leaveTypeId], references: [id])
  approver      EmployeeProfile? @relation("HrLeaveApprover", fields: [approverId], references: [id])

  @@index([tenantId, status, startDate])
  @@index([tenantId, employeeId, startDate])
}

model HrLeaveBalance {
  id                 String          @id @default(cuid())
  tenantId           String
  employeeId         String
  leaveTypeId        String
  year               Int
  entitledDays       Float           @default(0)
  accruedDays        Float           @default(0)
  takenDays          Float           @default(0)
  carriedForwardDays Float           @default(0)
  updatedAt          DateTime        @updatedAt
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee           EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          HrLeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId, year, employeeId])
}

model HrHoliday {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  holidayDate DateTime
  confirmed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, holidayDate, name])
  @@index([tenantId, holidayDate])
}

model HrEmployeeDocument {
  id               String          @id @default(cuid())
  tenantId         String
  employeeId       String
  kind             String
  name             String
  number           String?
  storageKey       String?
  originalFilename String?
  contentType      String?
  sizeBytes        Int?
  sha256           String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  verifiedAt       DateTime?
  /// PENDING until a scanner returns a verdict. Download is gated on CLEAN, so a
  /// file that was never scanned — because the scanner was down — is never served.
  scanStatus       HrScanStatus    @default(PENDING)
  scanProvider     String?
  scannedAt        DateTime?
  /// Engine and signature-database version, so a past clean verdict can be
  /// re-judged when a signature set is later found to have missed something.
  scanSignature    String?
  quarantined      Boolean         @default(true)
  createdAt        DateTime        @default(now())
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, kind])
}

model HrWorkLocation {
  id                  String                         @id @default(cuid())
  tenantId            String
  name                String
  code                String?
  locationType        String                         @default("BRANCH_OFFICE")
  address             String?
  emirate             String?
  country             String                         @default("United Arab Emirates")
  latitude            Float
  longitude           Float
  radiusMeters        Int                            @default(150)
  maxAccuracyMeters   Int                            @default(100)
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  openingTime         String?
  closingTime         String?
  workingDays         Int[]                          @default([])
  status              String                         @default("DRAFT")
  notes               String?
  isActive            Boolean                        @default(true)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  tenant              Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecords   HrAttendanceRecord[]
  attendancePunches   HrAttendancePunch[]
  temporaryRequests   HrTemporaryLocationRequest[]
  exceptionRequests   HrAttendanceExceptionRequest[]
  employeeAssignments HrEmployeeLocationAssignment[]
  requisitions        HrRequisition[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, status, effectiveFrom, effectiveTo])
}

model HrEmployeeLocationAssignment {
  id               String           @id @default(cuid())
  tenantId         String
  employeeId       String
  locationId       String
  assignmentType   String           @default("PRIMARY")
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  checkInAllowed   Boolean          @default(true)
  checkOutAllowed  Boolean          @default(true)
  allowedDays      Int[]            @default([])
  allowedStartTime String?
  allowedEndTime   String?
  checkoutRule     String           @default("SAME_LOCATION")
  status           String           @default("ACTIVE")
  notes            String?
  assignedById     String?
  assignedAt       DateTime         @default(now())
  revokedById      String?
  revokedAt        DateTime?
  revocationReason String?
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         EmployeeProfile  @relation("HrLocationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  location         HrWorkLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assignedBy       EmployeeProfile? @relation("HrLocationAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId, status, effectiveFrom, effectiveTo])
  @@index([tenantId, locationId, status])
}

model HrChecklistTask {
  id              String           @id @default(cuid())
  tenantId        String
  employeeId      String
  phase           String
  title           String
  ownerDepartment String?
  sequence        Int              @default(0)
  dueDate         DateTime?
  blocking        Boolean          @default(false)
  notes           String?
  completedAt     DateTime?
  completedById   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        EmployeeProfile  @relation("HrChecklistEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  completedBy     EmployeeProfile? @relation("HrChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId, phase, title])
  @@index([tenantId, phase, completedAt, dueDate])
}

model HrOffboardingCase {
  id                  String                 @id @default(cuid())
  tenantId            String
  employeeId          String
  noticeGivenOn       DateTime
  noticePeriodDays    Int
  lastWorkingOn       DateTime
  separationType      String
  reason              String
  noticeShortfallDays Int                    @default(0)
  settlementPaidAt    DateTime?
  startedById         String?
  startedAt           DateTime               @default(now())
  completedAt         DateTime?
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee            EmployeeProfile        @relation("HrOffboardingEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  startedBy           EmployeeProfile?       @relation("HrOffboardingStarter", fields: [startedById], references: [id], onDelete: SetNull)
  settlements         HrSettlementSnapshot[]

  @@index([tenantId, employeeId, completedAt])
}

model HrSettlementSnapshot {
  id                String            @id @default(cuid())
  tenantId          String
  employeeId        String
  offboardingCaseId String
  policyVersion     String
  inputs            Json
  calculation       Json
  calculatedAt      DateTime          @default(now())
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          EmployeeProfile   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  offboardingCase   HrOffboardingCase @relation(fields: [offboardingCaseId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, calculatedAt(sort: Desc)])
}

model BiometricConsent {
  id            String          @id @default(cuid())
  tenantId      String
  employeeId    String
  grantedAt     DateTime?
  withdrawnAt   DateTime?
  policyVersion String
  createdAt     DateTime        @default(now())
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
}

enum HrScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum HrPunchType {
  CHECK_IN
  CHECK_OUT
}

enum HrPunchResult {
  ACCEPTED
  FLAGGED_REVIEW
  REJECTED_FACE
  REJECTED_LIVENESS
  REJECTED_GEOFENCE
  REJECTED_ACCURACY
  REJECTED_DUPLICATE
  REJECTED_STALE_SYNC
}

/// A 512-float ArcFace embedding. Raw enrolment images are never stored — the
/// embedding is not reversible into a photograph, which is what makes keeping it
/// proportionate. Deleted outright when biometric consent is withdrawn.
model HrFaceTemplate {
  id           String          @id @default(cuid())
  tenantId     String
  employeeId   String
  embedding    Bytes
  dim          Int             @default(512)
  modelVersion String          @default("buffalo_l")
  createdAt    DateTime        @default(now())
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
}

/// Every attempt, accepted or rejected. A rejected punch is exactly when the
/// evidence matters most: it is the record of who tried and why it failed.
model HrAttendancePunch {
  id                String                         @id @default(cuid())
  tenantId          String
  employeeId        String
  punchType         HrPunchType
  result            HrPunchResult
  method            String                         @default("face")
  serverTime        DateTime                       @default(now())
  clientTime        DateTime?
  latitude          Float?
  longitude         Float?
  gpsAccuracyM      Float?
  distanceM         Float?
  faceScore         Float?
  livenessScore     Float?
  deviceFingerprint String?
  mockLocationFlag  Boolean                        @default(false)
  rejectCode        String?
  rejectReason      String?
  syncedOffline     Boolean                        @default(false)
  clientPunchUid    String?
  requestId         String?
  serverIp          String?
  locationId        String?
  locLatitude       Float?
  locLongitude      Float?
  locRadiusM        Int?
  capturePath       String?
  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          EmployeeProfile                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location          HrWorkLocation?                @relation(fields: [locationId], references: [id])
  exceptionRequests HrAttendanceExceptionRequest[]

  /// Idempotency for offline replay: the same queued punch synced twice is one row.
  @@unique([tenantId, employeeId, clientPunchUid])
  @@index([tenantId, employeeId, serverTime(sort: Desc)])
  @@index([tenantId, result, serverTime(sort: Desc)])
}

enum HrTemporaryRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/**
 * A payroll run's position in the maker-checker chain.
 * DRAFT is the only state that recalculates. Once approved, the numbers are
 * evidence: LOCKED additionally freezes the overtime claims the run consumed, so
 * a payslip already issued keeps reconciling against the hours behind it.
 */
enum HrPayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  LOCKED
  PAID
  CANCELLED
}

/**
 * Which side of the payslip a line falls on.
 */
enum HrPayComponentKind {
  EARNING
  DEDUCTION
}

enum HrCycleType {
  ANNUAL
  SEMIANNUAL
  QUARTERLY
  PROBATION
  CUSTOM
}

enum HrCycleStatus {
  DRAFT
  OPEN
  CALIBRATION
  CLOSED
}

/**
 * A review moves in one direction. The employee writes first so the manager's
 * rating is informed by it rather than the other way round, and the employee
 * acknowledges last so nothing is finalised behind their back.
 */
enum HrReviewStatus {
  PENDING_SELF
  PENDING_MANAGER
  CALIBRATION
  AWAITING_ACKNOWLEDGEMENT
  COMPLETE
}

enum HrGoalStatus {
  DRAFT
  ACTIVE
  ACHIEVED
  MISSED
  CANCELLED
}

enum HrPipStatus {
  DRAFT
  ACTIVE
  COMPLETED_SUCCESS
  COMPLETED_FAILED
  CANCELLED
}

enum HrRequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  ON_HOLD
  CLOSED
  REJECTED
}

/**
 * The hiring pipeline. Terminal states sit alongside the progression rather than
 * after it, because a candidate can be rejected or withdraw from any stage.
 */
enum HrCandidateStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  ASSESSMENT
  FINAL_INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
  ON_HOLD
}

enum HrInterviewType {
  PHONE
  VIDEO
  ONSITE
  PANEL
  TECHNICAL
}

enum HrInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum HrRecommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum HrOfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

/**
 * How a rostered day came to exist. Kept so a swapped shift is distinguishable from a planned one.
 */
enum HrRosterSource {
  ROSTER
  OVERRIDE
  SWAP
}

enum HrShiftChangeKind {
  CHANGE
  SWAP
}

enum HrShiftChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * Where an overtime claim came from. Detection is advisory; only a decision pays.
 */
enum HrOvertimeSource {
  DETECTED
  REQUESTED
}

/**
 * Which statutory rate applies. UAE Federal Decree-Law 33/2021 art. 19 sets the
 * ordinary uplift and a higher one for night hours; rest-day and public-holiday
 * work are compensated differently again. The multipliers themselves are
 * workspace settings — only the categories are fixed, because a report that
 * groups by "kind" has to mean the same thing in every workspace.
 */
enum HrOvertimeKind {
  NORMAL
  NIGHT
  WEEKEND
  HOLIDAY
}

enum HrOvertimeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HrExceptionStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
}

/// A request to work from somewhere that is not an approved site. On approval it
/// materialises into a real, date-bounded work location plus temporary
/// assignments — so the geofence still decides every punch, it is just pointed
/// somewhere new for a fixed window.
model HrTemporaryLocationRequest {
  id                String                   @id @default(cuid())
  tenantId          String
  name              String
  latitude          Float
  longitude         Float
  radiusMeters      Int
  validFrom         DateTime
  validTo           DateTime
  reason            String
  /// The employees the temporary site should cover. Stored as an array rather
  /// than the original's comma-separated string so it can be queried.
  employeeIds       String[]                 @default([])
  status            HrTemporaryRequestStatus @default(PENDING)
  requestedById     String
  requestedAt       DateTime                 @default(now())
  approverId        String?
  decidedAt         DateTime?
  decisionNote      String?
  createdLocationId String?
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy       EmployeeProfile          @relation("HrTempRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approver          EmployeeProfile?         @relation("HrTempApprover", fields: [approverId], references: [id], onDelete: SetNull)
  createdLocation   HrWorkLocation?          @relation(fields: [createdLocationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, requestedAt(sort: Desc)])
}

/// A missed or out-of-fence punch, corrected through people rather than through
/// the geofence. Two stages on purpose: the line manager knows whether the
/// employee was really at the client site, HR owns the attendance record. On
/// final approval an accepted punch is written at the requested time — the
/// original rejection stays in the log, because deleting it would erase the
/// evidence of what actually happened.
model HrAttendanceExceptionRequest {
  id                String             @id @default(cuid())
  tenantId          String
  employeeId        String
  requestedAction   HrPunchType
  requestedFor      DateTime
  latitude          Float?
  longitude         Float?
  nearestLocationId String?
  distanceM         Float?
  reasonCode        String
  reasonText        String?
  attachmentName    String?
  status            HrExceptionStatus  @default(PENDING_MANAGER)
  managerId         String?
  managerComment    String?
  managerAt         DateTime?
  hrId              String?
  hrComment         String?
  hrAt              DateTime?
  createdPunchId    String?
  createdAt         DateTime           @default(now())
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          EmployeeProfile    @relation("HrExceptionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager           EmployeeProfile?   @relation("HrExceptionManager", fields: [managerId], references: [id], onDelete: SetNull)
  hr                EmployeeProfile?   @relation("HrExceptionHr", fields: [hrId], references: [id], onDelete: SetNull)
  nearestLocation   HrWorkLocation?    @relation(fields: [nearestLocationId], references: [id], onDelete: SetNull)
  createdPunch      HrAttendancePunch? @relation(fields: [createdPunchId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, employeeId, createdAt(sort: Desc)])
}

model PlatformSession {
  id             String    @id @default(cuid())
  platformUserId String
  activeTenantId String?
  tokenHash      String    @unique
  ipAddress      String?
  userAgent      String?
  deviceLabel    String?
  mfaSatisfied   Boolean   @default(false)
  /// What this session is allowed to do. FULL is an ordinary signed-in session.
  /// MFA_ENROLMENT is a short-lived grant that may reach only the enrolment,
  /// verification and logout endpoints — issued when a workspace mandates 2FA
  /// and the user has not enrolled yet. Without it, turning on mandatory 2FA
  /// locked out every user who had not already enrolled, permanently.
  purpose        String    @default("FULL")
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime  @default(now())

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  activeTenant Tenant?      @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([platformUserId, revokedAt])
  @@index([activeTenantId, platformUserId])
  @@index([expiresAt])
}

/// Global control-plane audit stream. Workspace events may carry tenantId, but
/// platform-owner actions are retained even when a workspace is deleted.
model PlatformAuditEvent {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  event       String
  objectType  String?
  objectId    String?
  metadata    Json     @default("{}")
  ipAddress   String?
  userAgent   String?
  requestId   String?
  occurredAt  DateTime @default(now())

  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  PlatformUser? @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([event, occurredAt(sort: Desc)])
}

model UserTeam {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  teamId    String
  isManager Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([tenantId, teamId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

model Role {
  id           String          @id @default(cuid())
  tenantId     String
  key          String
  name         String
  description  String?
  isSystem     Boolean         @default(false)
  /**
   * A deactivated role grants nothing and cannot be assigned, but keeps its history.
   */
  isActive     Boolean         @default(true)
  rank         Int             @default(100)
  defaultScope VisibilityScope @default(OWN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdById  String?
  updatedById  String?

  users           User[]
  permissions     RolePermission[]
  membershipRoles MembershipRole[]
  invitations     WorkspaceInvitation[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(cuid())
  module      String
  action      PermissionAction
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  id           String          @id @default(cuid())
  tenantId     String
  roleId       String
  permissionId String
  granted      Boolean         @default(true)
  scope        VisibilityScope @default(OWN)
  conditions   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId, roleId])
}

model FieldPermission {
  id           String   @id @default(cuid())
  tenantId     String
  roleId       String
  objectType   String
  fieldKey     String
  canView      Boolean  @default(true)
  canEdit      Boolean  @default(false)
  maskStrategy String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([roleId, objectType, fieldKey])
  @@index([tenantId, objectType])
}

