}

enum TargetMetric {
  LEADS_ASSIGNED
  CALLS_ATTEMPTED
  CALLS_CONNECTED
  FOLLOWUPS_COMPLETED
  INVITATIONS_SENT
  RSVPS_CONFIRMED
  LEADS_QUALIFIED
  LEADS_CONVERTED
}

model EmployeeTarget {
  id          String       @id @default(cuid())
  tenantId    String
  userId      String
  campaignId  String?
  metric      TargetMetric
  period      TargetPeriod @default(DAILY)
  targetValue Int
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?

  user     User             @relation(fields: [userId], references: [id])
  progress TargetProgress[]

  @@index([tenantId, userId, periodStart, periodEnd])
  @@index([tenantId, campaignId])
}

model TargetProgress {
  id        String   @id @default(cuid())
  tenantId  String
  targetId  String
  userId    String
  dateKey   String
  achieved  Int      @default(0)
  updatedAt DateTime @updatedAt

  target EmployeeTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, dateKey])
  @@index([tenantId, userId, dateKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// CALLS, RECORDINGS & AI ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

enum CallStatus {
  SCHEDULED
  RINGING
  IN_PROGRESS
  COMPLETED
  MISSED
  FAILED
  CANCELLED
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  VOICEMAIL
  WRONG_NUMBER
  CALLBACK_REQUESTED
  NOT_INTERESTED
  INTERESTED
  QUALIFIED
  CONVERTED
}

enum ConsentMethod {
  VERBAL
  WRITTEN
  ELECTRONIC
  PRE_AUTHORIZED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  INSUFFICIENT_DATA
}

model Call {
  id              String                 @id @default(cuid())
  tenantId        String
  leadId          String?
  contactId       String?
  accountId       String?
  campaignId      String?
  /** Set when this call is a meeting held for an Event — the recording, consent,
   *  transcript and AI summary pipeline is shared with ordinary calls. */
  eventId         String?
  callerId        String
  caller          User                   @relation("CallerUser", fields: [callerId], references: [id])
  direction       CommunicationDirection @default(OUTBOUND)
  status          CallStatus             @default(SCHEDULED)
  outcome         CallOutcome?
  externalCallId  String?
  providerName    String?
  callerNumber    String?
  recipientNumber String?
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSecs    Int?
  notes           String?
  followUpAt      DateTime?
  scriptId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  recording  Recording?
  consent    RecordingConsent?
  transcript Transcript?
  analysis   AIAnalysis?
  callAudits CallAudit[]

  @@unique([tenantId, providerName, externalCallId])
  @@index([tenantId, callerId, createdAt(sort: Desc)])
  @@index([tenantId, leadId, createdAt(sort: Desc)])
  @@index([tenantId, campaignId, createdAt(sort: Desc)])
  @@index([tenantId, eventId, createdAt(sort: Desc)])
  @@index([tenantId, status])
}

model Recording {
  id             String    @id @default(cuid())
  tenantId       String
  callId         String    @unique
  storageKey     String
  storageBucket  String?
  mimeType       String    @default("audio/webm")
  sizeBytes      Int?
  durationSecs   Int?
  encryptionKey  String?
  retainUntil    DateTime?
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([tenantId, retainUntil])
}

model RecordingConsent {
  id             String         @id @default(cuid())
  tenantId       String
  callId         String         @unique
  consentGiven   Boolean
  method         ConsentMethod?
  consentedBy    String?
  consentVersion String?
  givenAt        DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime       @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([tenantId, callId])
}

model Transcript {
  id         String   @id @default(cuid())
  tenantId   String
  callId     String   @unique
  content    String
  language   String   @default("en")
  provider   String?
  confidence Float?
  wordCount  Int?
  createdAt  DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([tenantId, callId])
}

model AIAnalysis {
  id              String         @id @default(cuid())
  tenantId        String
  callId          String         @unique
  status          AnalysisStatus @default(PENDING)
  modelId         String?
  summary         String?
  clientNeeds     Json           @default("[]")
  objections      Json           @default("[]")
  commitments     Json           @default("[]")
  buyingSignals   Json           @default("[]")
  risks           Json           @default("[]")
  nextSteps       Json           @default("[]")
  topicsDiscussed Json           @default("[]")
  topicsMissed    Json           @default("[]")
  sentiment       String?
  sentimentScore  Float?
  suggestedStatus String?
  complianceFlags Json           @default("[]")
  uncertainItems  Json           @default("[]")
  rawOutput       Json?
  humanCorrected  Boolean        @default(false)
  correctedById   String?
  correctedAt     DateTime?
  errorMessage    String?
  processingMs    Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, callId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL AUDIT & COACHING
// ─────────────────────────────────────────────────────────────────────────────

model AuditScorecard {
  id          String   @id @default(cuid())
  tenantId    String
  campaignId  String?
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  criteria AuditCriterion[]

  @@index([tenantId, campaignId])
}

model AuditCriterion {
  id          String  @id @default(cuid())
  tenantId    String
  scorecardId String
  label       String
  description String?
  weight      Float   @default(1.0)
  position    Int     @default(0)
  isRequired  Boolean @default(false)

  scorecard AuditScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@index([tenantId, scorecardId, position])
}

model CallAudit {
  id             String         @id @default(cuid())
  tenantId       String
  callId         String
  scorecardId    String
  overallScore   Float?
  maxScore       Float?
  status         AnalysisStatus @default(PENDING)
  criteriaScores Json           @default("[]")
  missedPoints   Json           @default("[]")
  strengths      Json           @default("[]")
  risks          Json           @default("[]")
  suggestions    Json           @default("[]")
  nextAction     String?
  errorMessage   String?
  humanReviewed  Boolean        @default(false)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([tenantId, callId])
  @@index([tenantId, scorecardId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FOLLOW-UP TASKS (extends the existing Task model via a linking table)
// ─────────────────────────────────────────────────────────────────────────────

model FollowUpTask {
  id          String     @id @default(cuid())
  tenantId    String
  leadId      String?
  callId      String?
  campaignId  String?
  ownerId     String
  title       String
  description String?
  dueAt       DateTime
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(OPEN)
  completedAt DateTime?
  outcome     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?
  deletedAt   DateTime?

  @@index([tenantId, ownerId, status, dueAt])
  @@index([tenantId, leadId])
  @@index([tenantId, callId])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTEGRATION CONNECTIONS
// ─────────────────────────────────────────────────────────────────────────────

model IntegrationConnection {
  id             String    @id @default(cuid())
  tenantId       String
  provider       String
  webhookKey     String    @unique @default(uuid())
  status         String    @default("DISCONNECTED")
  credentials    Json?
  scopes         String[]  @default([])
  externalUserId String?
  expiresAt      DateTime?
  refreshToken   String?
  metadata       Json      @default("{}")
  lastSyncAt     DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WEBHOOK EVENTS (idempotent processing)
// ─────────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id           String    @id @default(cuid())
  tenantId     String
  provider     String
  externalId   String
  eventType    String
  payload      Json
  processed    Boolean   @default(false)
  processedAt  DateTime?
  attempts     Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@unique([tenantId, provider, externalId])
  @@index([provider, processed, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENTS & RSVP
// ─────────────────────────────────────────────────────────────────────────────

enum EventType {
  ONLINE
  PHYSICAL
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
  TENTATIVE
  NO_RESPONSE
  ATTENDED
  NO_SHOW
}

enum InviteChannel {
  EMAIL
  WHATSAPP
  SMS
  IN_APP
}

model Event {
  id                 String      @id @default(cuid())
  tenantId           String
  campaignId         String?
  title              String
  description        String?
  eventType          EventType   @default(PHYSICAL)
  status             EventStatus @default(DRAFT)
  startAt            DateTime
  endAt              DateTime
  timezone           String      @default("Asia/Dubai")
  hostId             String?
  location           String?
  address            String?
  latitude           Float?
  longitude          Float?
  meetingUrl         String?
  capacity           Int?
  registeredCount    Int         @default(0)
  attendedCount      Int         @default(0)
  externalCalendarId String?
  externalMeetId     String?
  notes              String?
  reminderSentAt     DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  invitees EventInvitee[]

  @@index([tenantId, status, startAt])
  @@index([tenantId, campaignId])
  @@index([tenantId, hostId])
}

model EventInvitee {
  id              String         @id @default(cuid())
  tenantId        String
  eventId         String
  leadId          String?
  contactId       String?
  userId          String?
  email           String?
  phone           String?
  name            String?
  rsvpStatus      RsvpStatus     @default(PENDING)
  rsvpAt          DateTime?
  rsvpChannel     InviteChannel?
  invitedAt       DateTime       @default(now())
  inviteChannel   InviteChannel  @default(EMAIL)
  inviteSentAt    DateTime?
  inviteDelivered Boolean        @default(false)
  reminderSentAt  DateTime?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  notes           String?
  createdAt       DateTime       @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, leadId])
  @@index([tenantId, eventId, rsvpStatus])
  @@index([tenantId, leadId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN SCRIPTS & TALKING POINTS
// ─────────────────────────────────────────────────────────────────────────────

model CampaignScript {
  id          String   @id @default(cuid())
  tenantId    String
  campaignId  String
  title       String
  content     String
  isDefault   Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  talkingPoints CampaignTalkingPoint[]

  @@index([tenantId, campaignId, position])
}

model CampaignTalkingPoint {
  id          String  @id @default(cuid())
  tenantId    String
  campaignId  String
  scriptId    String?
  label       String
  description String?
  isRequired  Boolean @default(false)
  position    Int     @default(0)

  script CampaignScript? @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  @@index([tenantId, campaignId, position])
}

model CampaignQualification {
  id             String  @id @default(cuid())
  tenantId       String
  campaignId     String
  question       String
  expectedAnswer String?
  isRequired     Boolean @default(true)
  position       Int     @default(0)

  @@index([tenantId, campaignId, position])
}

model CampaignMember {
  id         String    @id @default(cuid())
  tenantId   String
  campaignId String
  userId     String
  role       String    @default("CALLER")
  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  @@unique([campaignId, userId])
  @@index([tenantId, campaignId])
  @@index([tenantId, userId])
}
