  revokedById      String?
  revokedAt        DateTime?
  revocationReason String?
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         EmployeeProfile  @relation("HrLocationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  location         HrWorkLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assignedBy       EmployeeProfile? @relation("HrLocationAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId, status, effectiveFrom, effectiveTo])
  @@index([tenantId, locationId, status])
}

model HrChecklistTask {
