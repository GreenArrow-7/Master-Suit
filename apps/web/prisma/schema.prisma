enum ModuleKey {
  HRMS
  SALES
}

enum SubscriptionState {
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
  CANCELED
}

model SubscriptionPlan {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  modules       ModuleKey[]
  seatLimit     Int
  storageMb     Int
  featureLimits Json        @default("{}")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  subscriptions TenantSubscription[]
  planModules   PlanModule[]
  planLimits    PlanLimit[]
}

model TenantSubscription {
  id                 String            @id @default(cuid())
  tenantId           String            @unique
  planId             String
  state              SubscriptionState @default(TRIAL)
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  externalCustomerId String?
  externalContractId String?
  canceledAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan     @relation(fields: [planId], references: [id])
  modules       SubscriptionModule[]
  billingEvents BillingEvent[]

  @@index([state, currentPeriodEnd])
}

model ModuleEntitlement {
  id        String            @id @default(cuid())
  tenantId  String
  module    ModuleKey
  state     SubscriptionState @default(TRIAL)
  limits    Json              @default("{}")
  startsAt  DateTime          @default(now())
  endsAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId, state])
}

model PlanModule {
  id        String           @id @default(cuid())
  planId    String
  module    ModuleKey
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, module])
}

model PlanLimit {
  id        String           @id @default(cuid())
  planId    String
  key       String
  value     Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model SubscriptionModule {
  id             String             @id @default(cuid())
  subscriptionId String
  module         ModuleKey
  state          SubscriptionState  @default(ACTIVE)
  limits         Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, module])
}

model WorkspaceUsage {
  id         String   @id @default(cuid())
  tenantId   String
  metric     String
  used       Int      @default(0)
  limit      Int?
  measuredAt DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric])
  @@index([tenantId, measuredAt])
}

model BillingEvent {
  id             String              @id @default(cuid())
  tenantId       String
  subscriptionId String?
  type           String
  amountMinor    Int?
  currency       String?
  externalId     String?
  metadata       Json                @default("{}")
  occurredAt     DateTime            @default(now())
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   TenantSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt(sort: Desc)])
}

model OrganizationSetting {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  productName           String   @default("Master App")
  logoUrl               String?
  faviconUrl            String?
  primaryColor          String   @default("#2447C7")
  accentColor           String   @default("#0E7C66")
  emailFromName         String?
  emailFromAddress      String?
  defaultTimezone       String   @default("Asia/Dubai")
  defaultLocale         String   @default("en-AE")
  defaultCurrency       String   @default("AED")
  fiscalYearStart       Int      @default(1)
  terminology           Json     @default("{}")
  workingHours          Json     @default("{}")
  quietHours            Json     @default("{}")
  passwordPolicy        Json     @default("{}")
  sessionTtlMinutes     Int      @default(480)
  mfaRequired           Boolean  @default(false)
  ipAllowlist           String[] @default([])
  retentionPolicy       Json     @default("{}")
  featureFlags          Json     @default("{}")
  /// Workspace overrides for the HR policy registry in src/services/hr/settings.ts.
  /// Only keys that differ from the statutory/product default are stored, so a
  /// default that changes in a release reaches every workspace that never
  /// overrode it.
  hrPolicy              Json     @default("{}")
  /// Administrator-chosen grid columns, keyed by object type ("LEAD": ["stage", ...]).
  /// Only the chosen order is stored; labels and rendering stay in
  /// src/lib/grid/columns.ts so a catalogue change reaches every workspace.
  gridColumns           Json     @default("{}")
  /// Which connected telephony vendor places this workspace's calls: twilio,
  /// exotel, knowlarity or plivo. One column rather than a TelephonyConfiguration
  /// table, because the per-vendor credentials and settings already have a home
  /// in IntegrationConnection — this records only which of them is the default.
  /// Null means "infer, if exactly one vendor is connected"; see
  /// src/lib/integrations/telephony/resolve.ts.
  telephonyProvider     String?
  /// Seconds a number is off-limits after it has been dialled. The rule the
  /// auto-dialer exists to keep: ringing somebody twice in five minutes is the
  /// complaint that ends a campaign, and it is not something to leave to an
  /// agent watching the clock.
  dialerCooldownSeconds Int      @default(300)
  /// Attempts before a contact is retired from the queue as EXHAUSTED.
  dialerMaxAttempts     Int      @default(4)
  /// Metres a site-visit punch may be from the property and still count as
  /// arrival. A tower has a car park, a gate and a sales centre, so the fence is
  /// wider than an office door — and how much wider is a workspace's call.
  visitGeofenceRadiusM  Int      @default(250)
  /// Kilometres per hour between two consecutive punches above which the pair is
  /// flagged for a human. Not blocked: a genuine visit from a passenger seat on
  /// a motorway looks exactly like this.
  visitMaxTravelKph     Int      @default(160)
  /// Roleplay sessions one rep may start per day. A practice turn is a billed
  /// model call, so the cap is the workspace's spend control, not a difficulty
  /// setting. 0 turns practice off.
  practiceDailyCap      Int      @default(10)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Region {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String
  headUserId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Branch {
  id           String    @id @default(cuid())
  tenantId     String
  regionId     String?
  name         String
  code         String
  addressLine  String?
  city         String?
  country      String?
  timezone     String    @default("Asia/Dubai")
  workingHours Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id])
  teams  Team[]
  users  User[]

  @@unique([tenantId, code])
  @@index([tenantId, regionId])
}

model Territory {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String
  branchId    String?
  countries   String[]  @default([])
  states      String[]  @default([])
  cities      String[]  @default([])
  postalCodes String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Department {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  teams        Team[]
  employees    EmployeeProfile[]
  requisitions HrRequisition[]
  invitations  WorkspaceInvitation[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Team {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  code         String
  branchId     String?
  departmentId String?
  managerId    String?
  parentTeamId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  parentTeam Team?       @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams Team[]      @relation("TeamHierarchy")
  members    UserTeam[]

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metaRoutings   MetaLeadFormRouting[]
  socialComments SocialComment[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@index([tenantId, managerId])
}

