  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, objectType, recordId, occurredAt(sort: Desc)])
  @@index([tenantId, actorUserId, occurredAt(sort: Desc)])
  @@index([tenantId, event, occurredAt(sort: Desc)])
}

model RateLimitCounter {
  id        String   @id @default(cuid())
  tenantId  String?
  bucketKey String   @unique
  count     Int      @default(0)
  windowEnd DateTime

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

