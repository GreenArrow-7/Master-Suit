# Proves the newest backup actually restores. Weekly.
#
# An untested backup is a hope, not a control — and "test restoration quarterly"
# written in a runbook had never once been done, which is the normal fate of a
# drill that costs somebody an afternoon.
#
# Safe to run against production at any time: restore-verify.sh works in a
# scratch `<db>_restorecheck` database that it creates and drops, and never
# touches the live one.
[Unit]
Description=Master Suite restore verification
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=__APP_DIR__/infra
EnvironmentFile=__CONFIG__
# `latest` is the symlink backup.sh maintains, so this always verifies the
# backup the server most recently took rather than one somebody picked.
#
# `--prefer-remote` pulls that run back from BACKUP_REMOTE and proves *that*
# copy — the only one that exists in the failure backups are for. This unit used
# to verify the local directory, which proved the backup and not the shipment;
# a truncated dump of the right length, a passphrase that differs from the one
# in the secret store, or a lifecycle rule that expired the objects all pass a
# shipment check and fail a restore. With no remote configured it says so and
# falls back to the local copy rather than failing the timer.
ExecStart=__APP_DIR__/scripts/restore-verify.sh --prefer-remote __BACKUP_ROOT__/latest
Nice=10
IOSchedulingClass=idle
# Six rather than four: the run now fetches the backup back before restoring it.
TimeoutStartSec=6h

[Install]
WantedBy=multi-user.target
