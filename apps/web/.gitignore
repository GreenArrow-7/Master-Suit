node_modules/
.next/
.next-prod/
.env
.env.local
# Deployment secrets: database passwords, SMTP credentials and the field
# encryption key. `.env.production.example` beside it is the template, and is
# the only one of the two that belongs in the repository.
.env.production
# Same, for the staging project. It holds a *separate* set of secrets — nothing
# is copied from .env.production, and rotating one environment must never touch
# another. `.env.staging.example` beside it is the template.
.env.staging
# PgBouncer's credential file: SCRAM verifiers for the application role, copied
# from pg_authid. The .example beside it is the template.
infra/pgbouncer-userlist.txt
*.log
# Scratch verification scripts and logs from local test runs
.verify/
.mobile-audit-auth.json

# Audit probe output: scripts/mobile-audit.mjs rewrites mobile-audit.json on
# every run, and all-findings.json is the static sweep's dump. Both are
# regenerated data, not sources — committed, they re-broke the format gate each
# time the probe ran. The reading of them lives in docs/MOBILE_UI_AUDIT.md.
mobile-audit.json
all-findings.json

# Redis snapshot, written by a redis-server started in this directory.
dump.rdb

# Generated by Next on every `next dev` and `next build`, and it differs
# between them: the dev run writes `import "./.next/dev/types/routes.d.ts"`,
# the build writes `./.next/types/routes.d.ts`. It was tracked, so it flipped
# back and forth across four commits depending on which command its author had
# run last — and now that `npm run verify` runs a build, it would flip for
# everybody who checks their work before pushing.
#
# Nothing needs it in the repository. `tsconfig.json` already includes both
# `.next/types/**` and `.next/dev/types/**` directly, `skipLibCheck` is on, and
# `tsc --noEmit` passes with the file absent — verified rather than assumed.
# Next writes it back on the first dev or build.
next-env.d.ts
.e2e-owner-mfa.json
