# Template for apps/web/.env.test — copy or run `npm run secrets`.
#
# The real .env.test is NOT tracked. It used to be, with live secret values in
# it; treat anything that was in git history as compromised and rotate it.
#
# The database credentials below are the local docker-compose defaults, the same
# ones published in .env.example. They are for localhost only and must never
# appear in a deployed environment.
NODE_ENV=test
PROCESS_ROLE=web
APP_URL=http://localhost:3000
# Owner role: fixtures create data across several tenants, which is exactly what
# the control plane does. RLS enforcement is proved separately by
# tests/tenant/rls.spec.ts, which connects as RLS_DATABASE_URL below.
# Container endpoints are written as 127.0.0.1, not localhost, deliberately.
#
# Node resolves `localhost` to ::1 first. Docker publishes on both stacks, but
# when its IPv6 listener stalls — which it does on Docker Desktop after a long
# uptime — every new connection is reset while the container itself stays
# healthy and `docker exec` keeps working. It surfaces as "Server has closed the
# connection" from Prisma and ECONNRESET from ioredis, across the whole suite at
# once, and looks like a database fault rather than a name-resolution one.
# 127.0.0.1 pins the IPv4 path and costs nothing.
DATABASE_URL=postgresql://master_saas_app:master_saas_app@127.0.0.1:5432/master_saas_test?schema=public
MIGRATION_DATABASE_URL=postgresql://leadflow:leadflow@127.0.0.1:5432/master_saas_test?schema=public
SHADOW_DATABASE_URL=postgresql://leadflow:leadflow@127.0.0.1:5432/master_saas_test_shadow?schema=public
# The NOBYPASSRLS role production connects as.
RLS_DATABASE_URL=postgresql://master_saas_app:master_saas_app@127.0.0.1:5432/master_saas_test?schema=public
# Database 15, and the same development password the compose stack sets.
REDIS_PASSWORD=leadflow
REDIS_URL=redis://:leadflow@127.0.0.1:6379/15
FIELD_ENCRYPTION_KEY=CHANGE_ME
WEBHOOK_SIGNING_PEPPER=CHANGE_ME
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=me-central-1
S3_BUCKET=master-saas-test
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test-secret
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=smtp in any deployed environment — production refuses to boot
# on `mock`, so a password-reset link can never be silently discarded.
# Port 465 uses implicit TLS; anything else requires STARTTLS and fails rather
# than falling back to plaintext.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Master Suite <no-reply@localhost>
WHATSAPP_PROVIDER=mock
ANTIVIRUS_PROVIDER=mock
LOG_LEVEL=error

TRUSTED_PROXY_CIDRS=none
