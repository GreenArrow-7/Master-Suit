# Deployment configuration for the Azure single-VM overlay.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   node scripts/generate-secrets.mjs .env.production
#
# This file is read two ways by one command: Compose substitutes ${...} from it
# for the overlay's own settings, and passes the whole file into the web, worker
# and migrate containers as env_file. It is never copied into an image.
#
# Hostnames below are compose service names, not localhost — the application
# runs inside the network, so `localhost` would point at its own container.

NODE_ENV=production
# Declared, never inferred: a production build refuses to boot without it, and
# refuses a database whose name belongs to another environment (docs/ENVIRONMENTS.md).
APP_ENV=production
PROCESS_ROLE=web
PORT=3000

# ── The two values that are specific to your deployment ──────────────────────
# APP_DOMAIN must already resolve to this VM's public IP before the first start:
# Caddy obtains a certificate over HTTP-01, which fails on a name that does not
# point here yet.
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
APP_URL=https://app.example.com

# ── Database: two roles, and the deployment does not start without both ──────
# POSTGRES_PASSWORD is the owning role (`leadflow`), used to initialise the
# cluster and to run migrations. DATABASE_URL is the application role
# (master_saas_app), which is NOBYPASSRLS and owns nothing.
#
# Pointing DATABASE_URL at the owning role is refused at boot, because a
# superuser — and a table owner — bypasses every tenant-isolation policy in the
# schema without any role attribute saying so.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
APP_DB_PASSWORD=CHANGE_ME_DIFFERENT_LONG_RANDOM

DATABASE_URL=postgresql://master_saas_app:CHANGE_ME_DIFFERENT_LONG_RANDOM@postgres:5432/leadflow?schema=public&connection_limit=20
MIGRATION_DATABASE_URL=postgresql://leadflow:CHANGE_ME_LONG_RANDOM@postgres:5432/leadflow?schema=public
# `prisma migrate deploy` replays committed migrations and needs no shadow
# database. Left empty deliberately.
SHADOW_DATABASE_URL=
DATABASE_REPLICA_URL=
# ── Redis ───────────────────────────────────────────────────────────────────
#
# Required. Redis carries queue payloads and cached actor permissions, and the
# `redis` container refuses to start without this — it is passed straight to
# `--requirepass`. `node scripts/generate-secrets.mjs .env.production` fills it in
# and rewrites REDIS_URL below to match.
#
# The two must agree. `npm run check:redis-auth` fails the build if they do not,
# because a URL still carrying yesterday's password fails with NOAUTH at the
# first queue operation and nowhere earlier.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ── Secrets: `node scripts/generate-secrets.mjs .env.production` fills these ──
# Both are checked at boot by decoded byte length and distinct-byte count, so a
# long placeholder string will not pass. FIELD_ENCRYPTION_KEY seals stored
# authenticator secrets: changing it later orphans every enrolled second factor
# unless you go through scripts/rotate-field-encryption-key.mjs, which re-wraps.
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
WEBHOOK_SIGNING_PEPPER=CHANGE_ME_32_BYTE_BASE64

# ── Proxy ────────────────────────────────────────────────────────────────────
# Caddy's address on the compose bridge network. Production refuses to start
# when this is empty or "none": with no declared proxy the application cannot
# attribute a request to a client, so per-IP rate limiting collapses into one
# shared bucket that an attacker can exhaust to lock out the whole platform.
# Docker's default address pools live inside 172.16.0.0/12.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── Object storage ───────────────────────────────────────────────────────────
# MinIO in the same compose project. The bucket is created on first use.
# Swap S3_ENDPOINT/S3_REGION for Azure Blob's S3-compatible endpoint or AWS S3
# if you would rather not run storage on the VM; nothing else changes.
S3_ENDPOINT=http://minio:9000
S3_REGION=me-central-1
S3_BUCKET=leadflow-documents
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
S3_FORCE_PATH_STYLE=true

# ── Providers ────────────────────────────────────────────────────────────────
# Every key in PROVIDER_KEYS (lib/env.ts) is checked at boot and the process
# exits if any of them still says `mock`. Read the note in DEPLOY-AZURE.md
# before changing the four below: only `smtp`, `hmac`, `clamav` and WhatsApp's
# `meta` have real adapters behind them. The others are accepted by the boot
# check but have no implementation, so the feature throws at the moment it is
# first used rather than at start.

# Real, and required: password resets are undeliverable without it. Port 465 is
# implicit TLS; anything else requires STARTTLS and fails rather than falling
# back to plaintext.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Master Suite <no-reply@example.com>

# Real adapters.
TELEPHONY_PROVIDER=hmac
ANTIVIRUS_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
ANTIVIRUS_TIMEOUT_MS=30000

# Real adapter (Meta Cloud API), configured per tenant in the integrations UI.
WHATSAPP_PROVIDER=meta

# No adapter exists for these. The value only has to differ from `mock` to get
# past the boot check; the feature will throw "Unknown provider" the first time
# it is exercised. Leave them until you have picked and implemented a vendor.
SMS_PROVIDER=unconfigured
ESIGNATURE_PROVIDER=unconfigured
AI_PROVIDER=unconfigured
AI_API_KEY=

# ── Face check-in ────────────────────────────────────────────────────────────
# Unset means face check-in is unavailable and attendance fails closed with a
# 503 naming what is missing — never a wave-through. Set FACE_SERVICE_TOKEN to
# any long random string; the compose overlay passes the same value to the
# service. Tune the threshold on your own staff and lighting.
FACE_SERVICE_URL=http://face:8000
# Required. The face container is started with FACE_SERVICE_ENV=production and
# refuses to boot without a token, because an unauthenticated biometric engine
# accepts frames from anything that can reach the port.
FACE_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM
FACE_MATCH_THRESHOLD=0.55
FACE_SAMPLES_REQUIRED=4
MAX_GPS_ACCURACY_M=100
ATTENDANCE_CAPTURE_DIR=storage/attendance
ATTENDANCE_CAPTURE_RETENTION_DAYS=180

# Required. The bearer token Prometheus scrapes GET /api/metrics with. Unset
# means the endpoint 404s, and the Prometheus container refuses to start rather
# than spend its life paging about a target it cannot authenticate to.
# `node scripts/generate-secrets.mjs .env.production` fills this in.
METRICS_TOKEN=

# ── Alerting ────────────────────────────────────────────────────────────────
#
# infra/docker-compose.azure.yml starts Prometheus and Alertmanager as part of
# this stack; Alertmanager refuses to start without a recipient, because alert
# rules that fire into nothing read as monitored while delivering nothing.
#
# Required. Where a firing alert is delivered. Relayed through the SMTP settings
# above, so this needs no separate credential.
ALERT_EMAIL_TO=
# Optional. Where `severity: page` goes, if that should be somewhere else —
# an on-call address, a pager gateway's inbound mailbox. Defaults to
# ALERT_EMAIL_TO.
ALERT_PAGE_EMAIL_TO=
# Optional. Defaults to EMAIL_FROM above.
ALERT_EMAIL_FROM=
# Optional, and secret if set: a Slack/Teams/PagerDuty-style inbound URL, which
# carries its own token in the path. Every notification is posted here as well
# as mailed. Email is a weak pager; this is how `severity: page` reaches
# something that actually wakes somebody.
ALERT_WEBHOOK_URL=
# Optional. How long Prometheus keeps samples. These series are low-cardinality
# — a few hundred, not a few hundred thousand — so 30d costs well under a GB.
PROMETHEUS_RETENTION=30d

API_RATE_LIMIT_PER_MIN=600
EXPORT_MAX_ROWS=500000
UPLOAD_MAX_MB=25
LOG_LEVEL=info

# Bootstrap only. The demo seed refuses to run when NODE_ENV is production, so
# the first owner is created by scripts/bootstrap-owner.mjs, which generates the
# password itself and prints it once. Only the address is configured here.
PLATFORM_OWNER_EMAIL=owner@example.com
