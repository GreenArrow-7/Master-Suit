# npm 12 blocks package install scripts by default. Prisma's postinstall is what
# generates the client, so without this every command fails with
#   Cannot find module '.prisma/client/default'
# These four are the only packages that need scripts, and all are first-party
# build tooling: Prisma generates the client, esbuild and sharp fetch platform
# binaries.
allow-scripts=prisma,@prisma/engines,esbuild,sharp,msgpackr-extract
