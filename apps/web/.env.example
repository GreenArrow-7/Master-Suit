NODE_ENV=development
PROCESS_ROLE=web
APP_URL=http://localhost:3000
PORT=3000

# Bootstrap only. Rotate immediately after the first owner signs in. Production
# should also provide PLATFORM_OWNER_MFA_SECRET before seeding.
PLATFORM_OWNER_EMAIL=owner@masterapp.local
PLATFORM_OWNER_PASSWORD=CHANGE_ME_AT_LEAST_16_CHARS
PLATFORM_OWNER_MFA_SECRET=

DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow?schema=public&connection_limit=20
SHADOW_DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow_shadow?schema=public
DATABASE_REPLICA_URL=
REDIS_URL=redis://localhost:6379/0

# openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_32_BYTE_BASE64
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
WEBHOOK_SIGNING_PEPPER=CHANGE_ME_32_BYTE_BASE64

SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Enable only when direct application access is blocked and the trusted load
# balancer overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_BUCKET=leadflow-documents
S3_ACCESS_KEY_ID=leadflow
S3_SECRET_ACCESS_KEY=leadflow123
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
TELEPHONY_PROVIDER=mock
ANTIVIRUS_PROVIDER=mock
AI_PROVIDER=mock
AI_API_KEY=

API_RATE_LIMIT_PER_MIN=600
EXPORT_MAX_ROWS=500000
IMPORT_CHUNK_SIZE=5000
UPLOAD_MAX_MB=25
LOG_LEVEL=debug

# Face check-in. Unset means face check-in is unavailable and attendance fails
# closed with a 503 naming what is missing — never a wave-through.
FACE_SERVICE_URL=http://127.0.0.1:8081
FACE_SERVICE_TOKEN=
# Cosine threshold against enrolled templates. Tune on your own staff and lighting.
FACE_MATCH_THRESHOLD=0.55
FACE_SAMPLES_REQUIRED=4
MAX_GPS_ACCURACY_M=100
ATTENDANCE_CAPTURE_DIR=storage/attendance
ATTENDANCE_CAPTURE_RETENTION_DAYS=180
