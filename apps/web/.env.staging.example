# Configuration for the staging project (infra/docker-compose.staging.yml).
#
#   cp .env.staging.example .env.staging
#   chmod 600 .env.staging
#   node scripts/generate-secrets.mjs .env.staging
#
# ── Nothing here is copied from .env.production ─────────────────────────────
#
# Not the database password, not FIELD_ENCRYPTION_KEY, not the Gemini key, not
# the metrics token. A staging deployment that shares a secret with production
# is a production credential stored in a place with none of production's
# operational attention — and rotating one environment then silently changes the
# other. `node scripts/generate-secrets.mjs .env.staging` writes fresh values for
# every generated key; the vendor credentials below are separate accounts or
# separate sub-keys, with their own spend caps.
#
# The one exception is data, and it goes the other way: docs/BACKUP-RECOVERY.md
# restores a production snapshot *into* staging, which is what makes a rehearsal
# worth running. Read the note above FIELD_ENCRYPTION_KEY before doing that —
# encrypted columns do not survive the trip.

NODE_ENV=production
# Declared, and cross-checked. src/lib/startup-check.ts reads the `_staging`
# marker out of DATABASE_URL below and kills the process unless this says
# `staging` — so a production connection string pasted into this file does not
# start, and neither does this file pointed at production.
APP_ENV=staging
PROCESS_ROLE=web
PORT=3000

# ── Reached over an SSH tunnel, not a public name ────────────────────────────
# Caddy binds 127.0.0.1:8080 on the host and terminates plain HTTP; there is no
# domain and no certificate, because staging holds a restored production
# snapshot and a public name would make it the softest route to that data.
#
#   ssh -L 8080:127.0.0.1:8080 azureuser@<vm>
#
# APP_URL must match what the browser actually asks for — it is what sign-in
# links, password-reset links and webhook callbacks are built from.
APP_URL=http://localhost:8080

# ── Database ─────────────────────────────────────────────────────────────────
# The `_staging` suffix is load-bearing, not decorative: it is the only
# automatic check that this project and production are different environments.
# Renaming it to match production's disables that check.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
APP_DB_PASSWORD=CHANGE_ME_DIFFERENT_LONG_RANDOM

DATABASE_URL=postgresql://master_saas_app:CHANGE_ME_DIFFERENT_LONG_RANDOM@postgres:5432/leadflow_staging?schema=public&connection_limit=20
MIGRATION_DATABASE_URL=postgresql://leadflow:CHANGE_ME_LONG_RANDOM@postgres:5432/leadflow_staging?schema=public
SHADOW_DATABASE_URL=
DATABASE_REPLICA_URL=
REDIS_URL=redis://redis:6379/0

# ── Secrets ──────────────────────────────────────────────────────────────────
# FIELD_ENCRYPTION_KEY seals stored authenticator secrets and other encrypted
# columns. Two things follow from it being different here:
#
#   * Restoring a production snapshot into staging brings ciphertext this key
#     cannot open. Enrolled second factors in the restored data will not
#     verify — which is correct, and is the reason a restored staging is not a
#     way to sign in as a customer. Re-enrol the accounts you need to test with.
#   * Never paste production's key in to "make the restore work". That turns
#     staging into a second place production's plaintext can be recovered from.
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
WEBHOOK_SIGNING_PEPPER=CHANGE_ME_32_BYTE_BASE64

# ── Proxy ────────────────────────────────────────────────────────────────────
# Caddy's address on this project's bridge network. Same requirement as
# production: a production build with no declared proxy refuses to start,
# because nothing else can attribute a request to a client.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── Object storage ───────────────────────────────────────────────────────────
# This project's own MinIO, in its own volume. A separate bucket name as well as
# separate credentials: pointing staging at production's bucket would let a
# rehearsal of the retention sweep delete production's recordings.
S3_ENDPOINT=http://minio:9000
S3_REGION=me-central-1
S3_BUCKET=leadflow-staging-documents
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ── Mail goes to a local mailbox, deliberately ───────────────────────────────
# Production sends through a real relay. This does not, and it is the one
# provider that is intentionally different between the two: staging runs against
# restored production data, so a notification or campaign job here would fan out
# to real customers' addresses from a rehearsal.
#
# Mailpit is a real SMTP transport — the message is composed, sent and delivered
# for real — it just lands on this host. Read it over the same tunnel:
#
#   ssh -L 8026:127.0.0.1:8026 azureuser@<vm>   # then http://localhost:8026
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Master Suite (staging) <no-reply@staging.invalid>

TELEPHONY_PROVIDER=hmac
ANTIVIRUS_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
ANTIVIRUS_TIMEOUT_MS=30000

WHATSAPP_PROVIDER=meta

# No adapter exists for these; the value only has to differ from `mock` to get
# past the boot check. Keep them identical to production's, so a feature that
# would throw there throws here first.
SMS_PROVIDER=unconfigured
ESIGNATURE_PROVIDER=unconfigured
AI_PROVIDER=unconfigured
# If you set a real Gemini key here, use a separate one with its own spend cap.
# src/lib/ai/usage.ts meters against the deployment key, and a staging run
# replaying a restored backlog of calls will spend real money.
AI_API_KEY=

# ── Face check-in ────────────────────────────────────────────────────────────
# FACE_SERVICE_ENV is `staging` in the overlay, which is not `development`, so
# apps/face/main.py refuses to start without this token. Its own value, not
# production's.
FACE_SERVICE_URL=http://face:8000
FACE_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM
FACE_MATCH_THRESHOLD=0.55
FACE_SAMPLES_REQUIRED=4
MAX_GPS_ACCURACY_M=100
ATTENDANCE_CAPTURE_DIR=storage/attendance
ATTENDANCE_CAPTURE_RETENTION_DAYS=180

# Its own scrape token. Point a second Prometheus job at this project's web
# container; the alert rules in infra/prometheus-alerts.yml apply unchanged, and
# a staging deployment firing QueueHasNoConsumer before production does is the
# entire point of having one.
METRICS_TOKEN=

API_RATE_LIMIT_PER_MIN=600
EXPORT_MAX_ROWS=500000
IMPORT_CHUNK_SIZE=5000
UPLOAD_MAX_MB=25
LOG_LEVEL=info

# Bootstrap only, and only for a staging database built from migrations rather
# than restored. The demo seed refuses to run when APP_ENV is `staging`, by name
# and independently by database name — staging rehearses production, and
# production has no personas in it.
PLATFORM_OWNER_EMAIL=owner@example.com
