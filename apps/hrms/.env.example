# ---- copy to .env and fill in. Never commit .env. ----
ENVIRONMENT=production

# SQLite (dev):
# DATABASE_URL=sqlite:///./manath_homes.db
# PostgreSQL (prod) - requires: pip install "psycopg[binary]"
DATABASE_URL=postgresql+psycopg://hrms:CHANGE_ME@localhost:5432/hrms

# 32+ chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

ALLOWED_EMAIL_DOMAINS=manathhomes.ae
CORS_ORIGINS=http://localhost:8000

GEOFENCE_DEFAULT_RADIUS_M=150
MAX_GPS_ACCURACY_M=100
MIN_PUNCH_INTERVAL_SECONDS=60
TIMEZONE=Asia/Dubai

# Seeding only - unset after first run
SEED_ADMIN_PASSWORD=
